+void Pacer::traceStall(const char* stage, Uint64 duration, Uint64 at, int pacingQueue, int renderQueue)
+{
+    // Only anomalies are logged; a bounded budget limits diagnostic overhead.
+    if (m_TraceEvents.fetch_add(1, std::memory_order_relaxed) >= 256) return;
+    SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                "RHRemote stall: stage=%s qpc=%llu gap_ms=%.3f pacing_q=%d render_q=%d",
+                stage, static_cast<unsigned long long>(at),
+                1000.0 * duration / m_TraceFrequency, pacingQueue, renderQueue);
 }
 
