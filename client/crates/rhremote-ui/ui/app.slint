    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"combobox",root.accessible-label,root.accessible-enabled,root.has-focus,false,root.accessible-expanded,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.accessible-enabled){root.focus();}}}
}
component CheckBox inherits BaseCheckBox {
    property <string> test-id:"check|"+root.accessible-label;
