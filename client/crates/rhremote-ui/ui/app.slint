import { ProgressIndicator, ScrollView as BaseScrollView, LineEdit as BaseLineEdit, CheckBox as BaseCheckBox, SpinBox as BaseSpinBox, ComboBox as BaseComboBox, Palette as WidgetPalette } from "std-widgets.slint";

export global Commands { callback trigger(string,string); }
export struct NoteBlock {text:styled-text,level:int,prefix:string,indent:float,code:bool,quote:bool,rule:bool}
export struct ReleaseHistoryRow {version:string,published:string,expanded:bool,blocks:[NoteBlock]}
component ReleaseNotes inherits VerticalLayout {
    in property <[NoteBlock]> blocks;
    spacing:12px;
    for block in root.blocks:Rectangle{
        min-height:block.rule?1px:note.preferred-height+(block.code||block.quote?24px:0px);
        background:block.rule?Palette.line:block.code?Palette.page:transparent;border-radius:block.code?6px:0px;
        HorizontalLayout{
            padding-left:block.indent*1px+(block.code||block.quote?12px:0px);padding-right:block.code?12px:0px;padding-top:block.code||block.quote?12px:0px;padding-bottom:block.code||block.quote?12px:0px;spacing:10px;
            if block.prefix!="":Text{text:block.prefix;color:Palette.ink;width:22px;font-size:14px;}
            note:=StyledText{text:block.text;visible:!block.rule;default-color:Palette.ink;default-font-size:block.level==1?24px:block.level==2?18px:block.level>2?16px:14px;default-font-family:block.code?"Consolas":"";link-color:Palette.blue;link-clicked(url)=>{Commands.trigger("updates.notes.open",url);}}
        }
        if block.quote:Rectangle{width:3px;background:Palette.line;}
    }
}
export global ModalContext {
    in-out property <string> allowed-action;
    out property <bool> active:ModalContext.allowed-action!="";
}
export global UiTest {
    in property <bool> enabled;
    in property <int> generation;
    in property <string> operation;
    in property <string> target;
    in property <float> scroll-delta;
    callback report(string,string,string,bool,bool,bool,bool,float,float,float,float);
}
export global KeyboardFocus {
    in-out property <string> last-content-control;
    in-out property <string> restore-target;
    in-out property <int> restore-generation;
    public function remember(id:string,focused:bool,content:bool){
        if(focused && content){KeyboardFocus.last-content-control=id;}
    }
}
export global ProfileErrorFocus {
    in-out property <string> target-key;
    in-out property <string> request-id;
    in-out property <string> consumed-request;
    in-out property <bool> allowed;
    in-out property <length> editor-top;
    in-out property <length> editor-height;
    in-out property <int> reveal-request;
    in-out property <int> viewport-revision;
}
global DiagnosticReveal {
    in-out property <int> request;
    in-out property <string> context;
    in-out property <length> top;
    in-out property <length> height;
}
component UiProbe inherits Rectangle {
    width:0px;height:0px;
    in property <string> control-id;
    in property <string> kind;
    in property <string> label;
    in property <bool> control-enabled:true;
    in property <bool> focused;
    in property <bool> checked;
    in property <bool> expanded;
    in property <bool> remember-focus:true;
    in property <length> control-width;
    in property <length> control-height;
    in property <length> scroll-y;
    in property <length> scroll-maximum;
    in property <int> request:UiTest.generation;
    callback focus-requested();
    callback activate-requested();
    callback scroll-requested(float);
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed focused=>{if(root.control-id!=""){KeyboardFocus.remember(root.control-id,root.focused,root.remember-focus);}}
    changed control-id=>{if(root.focused && root.control-id!=""){KeyboardFocus.remember(root.control-id,true,root.remember-focus);}}
    changed restore-request=>{if(root.control-id!="" && KeyboardFocus.restore-target==root.control-id && root.control-enabled){root.focus-requested();}}
    changed request=>{
        if(UiTest.enabled && root.control-id!=""){
            if(UiTest.operation=="inspect"){
                UiTest.report(root.control-id,root.kind,root.label,root.control-enabled,root.focused,root.checked,root.expanded,root.control-width/1px,root.control-height/1px,root.scroll-y/1px,root.scroll-maximum/1px);
            }else if(UiTest.target==root.control-id && root.control-enabled){
                if(UiTest.operation=="focus"){root.focus-requested();}
                else if(UiTest.operation=="activate"){root.activate-requested();}
                else if(UiTest.operation=="scroll" && root.kind=="scroll"){root.scroll-requested(UiTest.scroll-delta);}
            }
        }
    }
}
component LineEdit inherits BaseLineEdit {
    property <string> test-label:root.accessible-label!="" ? root.accessible-label : root.placeholder-text;
    property <string> test-id:"input|"+root.test-label;
    accessible-id:root.test-id;
    accessible-enabled:root.enabled && !ModalContext.active;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"input",root.test-label,root.accessible-enabled,root.has-focus,false,false,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.accessible-enabled){root.focus();}}}
}
component ProfileErrorEditor inherits LineEdit {
    in property <string> field-key;
    private property <string> error-request:ProfileErrorFocus.request-id;
    private property <bool> error-allowed:ProfileErrorFocus.allowed;
    private property <int> viewport-revision:ProfileErrorFocus.viewport-revision;
    function reveal-focused-error(){
        if(root.error-allowed && root.has-focus && ProfileErrorFocus.target-key==root.field-key
            && ProfileErrorFocus.consumed-request==root.error-request){
            ProfileErrorFocus.editor-top=root.absolute-position.y;
            ProfileErrorFocus.editor-height=root.height;
            ProfileErrorFocus.reveal-request+=1;
        }
    }
    function focus-requested-error(){
        if(root.error-allowed && root.enabled && root.error-request!=""
            && ProfileErrorFocus.target-key==root.field-key && ProfileErrorFocus.consumed-request!=root.error-request){
            root.focus();ProfileErrorFocus.consumed-request=root.error-request;
            root.reveal-focused-error();
        }
    }
    init=>{root.focus-requested-error();}
    changed error-request=>{root.focus-requested-error();}
    changed error-allowed=>{root.focus-requested-error();}
    changed viewport-revision=>{root.reveal-focused-error();}
}
component ComboBox inherits BaseComboBox {
    property <string> test-id:"choice|"+root.accessible-label;
    accessible-id:root.test-id;
