    init => { WidgetPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { WidgetPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    icon:@image-url("../../../shared/icons/rhremote.svg");
    title:root.session-name!="" ? root.session-name+" · RHRemote-Moonlight" : root.isolated-preview ? "RHRemote-Moonlight · 测试预览" : "RHRemote-Moonlight";preferred-width:1180px;preferred-height:780px;min-width:720px;min-height:560px;
    private property <bool> device-context:!root.session-window && !root.streaming && !root.connecting;
    private property <bool> narrow-profile:content-pane.width<560px;
    in property <bool> isolated-preview;
    background:Palette.page;default-font-family:"Microsoft YaHei UI";default-font-size:14px;
    in property <[DeviceRow]> devices;
    in property <bool> devices-refreshing;
    in property <string> devices-refresh-error;
    in property <DeviceRow> selected-device;
    in-out property <string> device-query;
    in-out property <string> add-address;
    in property <string> add-phase:"editing";
    in property <string> add-error;
    in-out property <string> info-name;
    in property <string> info-error;
    in property <bool> info-dirty;
    private property <bool> add-busy:root.add-phase=="probing";
    in property <int> device-total;
    in property <int> device-online;
    in property <int> selected-index;
    in property <string> page:"devices";
    in property <string> app-version;
    in property <string> selected-name;
    in property <string> client-name;
    in property <string> selected-uuid;
    in-out property <string> network-address;
    in-out property <string> network-addresses;
    in property <string> network-report;
    in property <string> diagnostic-summary;
    in property <bool> diagnostic-busy;
    in property <bool> diagnostic-start-disabled;
    in property <bool> diagnostic-own;
    in property <bool> diagnostic-failed;
    in property <string> diagnostic-start-label;
    in property <string> diagnostic-start-args;
    in property <bool> diagnostic-can-cancel;
    in property <string> diagnostic-cancel-label;
    in property <string> diagnostic-cancel-args;
    in property <bool> diagnostic-details-visible;
    in property <bool> diagnostic-details-expanded;
    in property <string> diagnostic-details-args;
    in property <bool> diagnostic-banner;
    in property <bool> diagnostic-banner-failed;
    in property <string> diagnostic-banner-text;
    in property <string> diagnostic-reveal-key;

    in property <[RouteRow]> network-routes;
    in-out property <string> relay-url;
    in property <string> draft-display-name;
    in property <[ProfileSource]> profile-sources;
    in property <string> profile-tab:"video";
