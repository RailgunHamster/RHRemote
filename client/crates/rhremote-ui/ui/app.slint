                            VerticalLayout {padding:root.compact ? 20px : 28px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:20px;alignment:start;
                                Rectangle {accessible-role:groupbox;accessible-label:"桌面连接区域";min-height:root.selected-device.check-hint!="" ? 164px : root.compact ? 132px : 148px;preferred-height:device-hero.preferred-height;vertical-stretch:0;border-radius:12px;border-width:1px;border-color:Palette.line;background:Palette.surface;clip:true;
                                    Rectangle {x:0px;y:0px;width:parent.width;height:3px;background:@linear-gradient(90deg, Palette.blue 0%, Palette.purple 100%);}
                                    device-hero:=HorizontalLayout {padding:20px;spacing:24px;
                                        if !root.compact: Rectangle {width:144px;border-radius:10px;background:@linear-gradient(135deg, Palette.soft 0%, Palette.page 100%);border-width:1px;border-color:Palette.line;
                                            Image {source:@image-url("icons/monitor.svg");width:54px;height:54px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2 - 6px;}
                                            Text {text:"Moonlight 串流";color:Palette.blue;font-size:11px;font-weight:600;height:20px;y:parent.height - 30px;horizontal-alignment:center;}
                                        }
                                        VerticalLayout {spacing:10px;alignment:center;
                                            Text {text:"桌面连接";font-size:16px;font-weight:600;color:Palette.ink;}
                                            Text {text:root.selected-device.is-self ? "本机不支持连接自身" : root.selected-session-hint!="" ? root.selected-session-hint : root.selected-device.check-hint!="" ? root.selected-device.check-hint : root.selected-device.pending ? "配对状态尚未确认" : root.selected-device.paired ? "已配对" : "连接前需要配对";font-size:12px;color:(root.selected-session-failed || root.selected-device.check-failed) ? Palette.failure : root.selected-session-phase=="connected" ? Palette.success : (root.selected-has-session && root.selected-session-phase!="failed") ? Palette.blue : Palette.muted;wrap:word-wrap;}
                                            HorizontalLayout {spacing:8px;
                                                ActionButton {text:root.selected-has-session ? "切换到窗口" : root.selected-device.is-self ? "本机" : root.selected-device.check-retry ? root.devices-refreshing ? "检查中…" : "检查连接" : root.selected-device.repair-required ? "重新配对" : root.selected-device.pending && !root.selected-device.paired ? root.devices-refreshing ? "检查中…" : "检查连接" : root.selected-device.paired ? "连接" : "配对";action-id:root.selected-has-session ? "session.activate" : (root.selected-device.check-retry || (root.selected-device.pending && !root.selected-device.paired && !root.selected-device.repair-required)) ? "devices.refresh" : root.selected-device.repair-required ? "device.pair" : root.selected-device.paired ? "device.connect" : "device.pair";argument:root.selected-has-session ? root.selected-session-id : root.selected-uuid;primary:true;disabled:!root.selected-has-session && (root.diagnostic-busy || root.selected-device.is-self || root.control-requests-pending || ((root.selected-device.check-retry || (root.selected-device.pending && !root.selected-device.paired && !root.selected-device.repair-required)) && root.devices-refreshing));min-width:112px;}
                                                if root.selected-has-session: ActionButton{text:root.selected-session-phase=="cancelling" || root.selected-session-phase=="cleaning" ? "正在断开…" : (root.selected-session-phase=="connected" || root.selected-session-phase=="reconnecting") ? "断开连接" : "取消连接";action-id:"session.close";argument:root.selected-session-id;disabled:root.selected-session-phase=="cancelling" || root.selected-session-phase=="cleaning";}
                                                if !root.selected-has-session && root.selected-device.pending && root.selected-device.online && !root.selected-device.is-self && !root.selected-device.check-retry && !root.selected-device.repair-required: ActionButton{text:"配对";action-id:"device.pair";argument:root.selected-uuid;disabled:root.diagnostic-busy || root.control-requests-pending;}
                                                ActionButton{text:"选择窗口";action-id:"device.windows.open";argument:root.selected-uuid;disabled:root.selected-has-session || root.window-picker-busy || root.diagnostic-busy || root.selected-device.is-self || !root.selected-device.paired || root.selected-device.check-retry || root.selected-device.repair-required || root.control-requests-pending;}
                                                Rectangle{horizontal-stretch:1;}
                                            }
                                        }
                                    }
                                }
                                Rectangle {background:Palette.surface;border-radius:10px;border-width:1px;border-color:Palette.line;preferred-height:spec-strip.preferred-height;
                                    spec-strip:=HorizontalLayout {padding:14px;spacing:16px;
                                        DetailField {label:"分辨率";value:root.profile-width+" × "+root.profile-height;}
                                        Rectangle {width:1px;background:Palette.line;}
                                        DetailField {label:"帧率";value:root.fps+" FPS";}
                                        Rectangle {width:1px;background:Palette.line;}
                                        DetailField {label:"码率";value:root.bitrate-auto ? "自动（连接时）" : root.bitrate+" Mbps";}
                                    }
                                }
                                HorizontalLayout {Text {text:"设备信息";font-size:14px;font-weight:600;color:Palette.ink;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}ActionButton{text:"编辑资料";action-id:"device.info.open";argument:root.selected-uuid;}}
                                HorizontalLayout {spacing:20px;
                                    DetailField {label:"首选地址";value:root.network-address;}
                                    pairing-status-field:=DetailField {label:"配对状态";value:root.selected-device.is-self ? "本机" : root.selected-device.check-failed ? root.selected-device.status : root.selected-device.pending ? root.selected-device.paired ? "已保存配对" : root.selected-device.status : root.selected-device.paired ? "已配对" : root.selected-device.status;value-color:root.selected-device.is-self ? Palette.blue : root.selected-device.check-failed ? Palette.failure : !root.selected-device.pending && root.selected-device.paired && root.selected-device.online ? Palette.success : Palette.muted;}
                                }
                                Text {text:root.network-summary;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                                Text {text:root.network-current;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                                Text {text:"当前客户端配置";font-size:14px;font-weight:600;color:Palette.ink;}
                                Rectangle {background:Palette.surface;border-radius:10px;border-width:1px;border-color:Palette.line;preferred-height:client-spec-strip.preferred-height;
                                    client-spec-strip:=HorizontalLayout {padding:14px;spacing:20px;
                                        DetailField {label:"视频编码";value:root.codec;}
                                        DetailField {label:"声音";value:root.profile-audio-enabled ? "开启" : "关闭";}
                                        DetailField {label:"屏幕";value:root.profile-display=="virtual" ? "虚拟屏" : "自动";}
                                    }
                                }
                                Rectangle {height:1px;background:Palette.line;}
                                Text {text:root.status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            }
                        }
                    }
                    if root.selected-uuid=="": VerticalLayout {alignment:center;spacing:20px;padding:32px;
                        Text {text:"远程设备";font-size:22px;color:Palette.ink;horizontal-alignment:center;}
                        Text {text:"尚未添加设备";font-size:13px;color:Palette.muted;horizontal-alignment:center;}
                        HorizontalLayout {Rectangle {horizontal-stretch:1;}ActionButton {text:"添加电脑";action-id:"device.add.open";primary:true;}Rectangle {horizontal-stretch:1;}}
                    }
                }
            if root.page=="pair":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:pair-header.preferred-height;
                pair-header:=VerticalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:6px;
                    Text{text:"配对";font-size:23px;font-weight:600;color:Palette.ink;}
                    Text{text:root.connection-name;color:Palette.muted;font-size:13px;overflow:elide;}
                }
            }
            if root.page=="profile-copy":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:copy-header.preferred-height;
                copy-header:=VerticalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:6px;
                    Text{text:"复制配置";font-size:23px;font-weight:600;color:Palette.ink;}
                    Text{text:root.copy-target;color:Palette.muted;font-size:13px;overflow:elide;}
                }
            }
            if root.page=="settings": VerticalLayout {spacing:0px;vertical-stretch:0;
                DeviceContextHeader{device:root.selected-device;name:root.selected-name;address:root.network-address;uuid:root.selected-uuid;content-inset:root.form-inset;settings-open:true;}
                Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:profile-header.preferred-height;
                    profile-header:=VerticalLayout {padding:9px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                        HorizontalLayout {spacing:8px;
                        TabButton{text:"画面";action-id:"settings.tab";argument:"video";chosen:root.profile-tab=="video";}
                        TabButton{text:"音频";action-id:"settings.tab";argument:"audio";chosen:root.profile-tab=="audio";}
                        TabButton{text:"输入";action-id:"settings.tab";argument:"input";chosen:root.profile-tab=="input";}
                        TabButton{text:"网络";action-id:"settings.tab";argument:"network";chosen:root.profile-tab=="network";}
                        TabButton{text:"高级";action-id:"settings.tab";argument:"advanced";chosen:root.profile-tab=="advanced";}
                        Rectangle{horizontal-stretch:1;}
                    }
                    }
                    Rectangle{y:parent.height - 1px;height:1px;background:Palette.line;}
                }
            }
            if root.page=="global-settings": VerticalLayout {padding-left:root.form-inset;padding-right:root.form-inset;padding-top:16px;spacing:12px;vertical-stretch:0;
                        HorizontalLayout{spacing:12px;BackButton{text:"返回";action-id:"devices.open";}Text{text:"设置";font-size:26px;font-weight:600;color:Palette.ink;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}}
                        HorizontalLayout{spacing:8px;
                            TabButton{text:"更新";action-id:"app.settings.tab";argument:"updates";chosen:root.settings-tab=="updates";}
                            TabButton{text:"代理";action-id:"app.settings.tab";argument:"proxy";chosen:root.settings-tab=="proxy";}
                            TabButton{text:"配置同步";action-id:"app.settings.tab";argument:"sync";chosen:root.settings-tab=="sync";}
                            TabButton{text:"外观";action-id:"app.settings.tab";argument:"appearance";chosen:root.settings-tab=="appearance";}
                            TabButton{text:"关于";action-id:"app.settings.tab";argument:"about";chosen:root.settings-tab=="about";}
                            Rectangle{horizontal-stretch:1;}
                        }
            }
            if root.page=="global-settings":Rectangle{height:1px;background:Palette.line;}
            if root.page=="global-settings" || root.page=="settings":Rectangle{height:12px;background:Palette.page;}
            if root.page=="connection" || root.page=="pair":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:connection-header.preferred-height;
                connection-header:=HorizontalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:12px;
                    BackButton{text:"返回设备";action-id:"connection.dismiss";disabled:root.connection-busy;}
                    Rectangle{horizontal-stretch:1;}
                }
            }
            if root.page=="device-info":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:info-header.preferred-height;
                info-header:=HorizontalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:12px;
                    BackButton{text:"返回设备";action-id:"navigation.back";}
                    Text{text:"设备资料";font-size:23px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}
                }
            }
            if root.page=="add":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:add-header.preferred-height;
                add-header:=HorizontalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:12px;
                    BackButton{text:"返回设备";action-id:"device.add.cancel";}
                    Text{text:"添加电脑";font-size:23px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}
                }
            }
            if root.page!="devices" || root.streaming || root.connecting: form-scroll:=ScrollView {test-id:"scroll|form";
                // Validation text can shrink the viewport after the focus event. Reveal
                // the outer editor using the actual layout, without re-focusing it or
                // reacting to ordinary user scrolling.
                private property <int> error-reveal:ProfileErrorFocus.reveal-request;
                private property <int> diagnostic-reveal:DiagnosticReveal.request;
                changed diagnostic-reveal=>{
                    if(root.page=="settings" && root.profile-tab=="network" && root.diagnostic-own && DiagnosticReveal.context==root.diagnostic-reveal-key){
                        let top=self.absolute-position.y;
                        // Reveal a nearby result only when its action row is still visible.
                        // A user who scrolled elsewhere keeps that position.
                        let result-bottom=DiagnosticReveal.top+DiagnosticReveal.height;
                        if(result-bottom+10px>=top && result-bottom+48px<=top+self.visible-height && DiagnosticReveal.top<top){
                            self.content-y=min(0px,self.content-y+top - DiagnosticReveal.top+4px);
                        }
                    }
                }
                changed height=>{ProfileErrorFocus.viewport-revision+=1;}
                changed width=>{ProfileErrorFocus.viewport-revision+=1;}
                changed error-reveal=>{
                    if(root.page=="settings" && ProfileErrorFocus.allowed){
                        let top=self.absolute-position.y;
                        let editor-top=ProfileErrorFocus.editor-top;
                        let bottom=editor-top+ProfileErrorFocus.editor-height;
                        let delta=editor-top<top ? top - editor-top : bottom>top+self.visible-height ? top+self.visible-height - bottom : 0px;
                        self.content-y=max(-max(0px,self.content-height - self.visible-height),min(0px,self.content-y+delta));
                    }
                }
                // A different page/category has different content. Ordinary draft and
                // background-state updates keep this key, so they retain the position.
                in property <string> content-context:root.page+"|"+(root.page=="settings" ? root.selected-uuid+"|"+root.profile-tab : root.page=="global-settings" ? root.settings-tab : "");
                changed content-context=>{self.content-y=0px;}
                in property <bool> syncing:root.sync-busy;
                changed syncing=>{if(!self.syncing && root.page=="global-settings" && root.settings-tab=="sync"){self.content-y=0px;}}
                content-width:self.width;
                VerticalLayout {
                    padding:root.compact ? 20px : 34px;padding-left:root.page=="settings" || root.page=="global-settings" || root.page=="add" || root.page=="device-info" || root.page=="profile-copy" ? root.form-inset : root.compact ? 20px : 34px;padding-right:root.page=="settings" || root.page=="global-settings" || root.page=="add" || root.page=="device-info" || root.page=="profile-copy" ? root.form-inset : root.compact ? 20px : 34px;spacing:18px;
                    if root.page=="profile-copy":VerticalLayout{spacing:18px;vertical-stretch:0;
                        DetailField{label:"来源客户端";value:root.copy-source;}
                        DetailField{label:"目标设备";value:root.copy-target;}
                        Text{text:"将替换当前草稿的连接参数。设备地址和主机鼠标设置沿用当前值。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        for field in root.copy-fields:DetailField{label:field.label;value:field.value;}
                    }
                    if root.page=="settings": SettingsCard {
                        if root.profile-tab=="advanced": VerticalLayout {spacing:12px;
                        HorizontalLayout{ActionButton{text:"从其他客户端复制配置";action-id:"settings.sources.toggle";chosen:root.profile-sources-expanded;disabled:root.profile-sources.length==0;}Rectangle{horizontal-stretch:1;}}
                        if root.profile-sources.length==0:Text{text:"同步其他客户端的连接设置后可复制。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.copy-error!="":Text{text:root.copy-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                        if root.profile-sources.length>0 && root.profile-sources-expanded: VerticalLayout{spacing:6px;
                            Text{text:"复制其他客户端的配置";color:Palette.muted;font-size:13px;}
                            for source in root.profile-sources: HorizontalLayout{spacing:8px;
                                Text{text:source.label;color:Palette.muted;vertical-alignment:center;font-size:12px;min-width:0px;preferred-width:0px;horizontal-stretch:1;overflow:elide;}
                                ActionButton{text:"查看配置";action-id:"settings.copy.preview";argument:source.client-id;}
                            }
                        }
                        }
                        if root.profile-tab=="network": VerticalLayout{spacing:10px;
                            Text{text:"连接会按路径顺序尝试所有已保存地址，内网地址不会限制外网连接。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            Text{text:"首选地址（IP 或主机名）";color:Palette.ink;wrap:word-wrap;}
                            network-primary:=ProfileErrorEditor{field-key:"address";text <=> root.network-address;accessible-label:"首选 IP 或主机名";placeholder-text:"首选 IP 或主机名";edited(value)=>{Commands.trigger("settings.network.edit","address="+value);}}
                            Text{text:"备用地址（逗号分隔，随 WebDAV 同步）";color:Palette.ink;wrap:word-wrap;}
                            network-extra:=ProfileErrorEditor{field-key:"addresses";text <=> root.network-addresses;accessible-label:"备用地址";placeholder-text:"备用地址，以逗号分隔，例如 100.x.x.x";edited(value)=>{Commands.trigger("settings.network.edit","addresses="+value);}}
                            diagnostic-summary:=Text{text:root.diagnostic-summary;color:root.diagnostic-failed ? Palette.failure : Palette.muted;font-size:12px;wrap:word-wrap;overflow:elide;preferred-height:36px;accessible-label:root.diagnostic-summary;
                                private property <string> outcome:root.diagnostic-reveal-key;
                                private property <string> previous-start-args;
                                private property <string> previous-details-args;
                                changed outcome=>{
                                    let start="action|device.network.diagnose|"+root.diagnostic-start-args+"|";
                                    let details="action|device.network.details.toggle|"+root.diagnostic-details-args+"|";
                                    let cancel="action|device.network.cancel|"+root.diagnostic-cancel-args+"|";
                                    let focus=KeyboardFocus.last-content-control;
                                    // A collapse click keeps its former bound arguments while
                                    // the outcome updates. Reveal only within that same task/draft.
                                    let collapsed-here=self.previous-start-args==root.diagnostic-start-args && focus=="action|device.network.details.toggle|"+self.previous-details-args+"|收起详情";
                                    self.previous-start-args=root.diagnostic-start-args;
                                    self.previous-details-args=root.diagnostic-details-args;
                                    if(!root.diagnostic-busy && !root.diagnostic-details-expanded && (collapsed-here || focus==start+"诊断连接" || focus==start+"诊断中…" || focus==start+"正在清理…" || focus==details+"收起详情" || focus==details+"查看详情" || focus==cancel+"取消诊断")){
                                        DiagnosticReveal.context=root.diagnostic-reveal-key;DiagnosticReveal.top=self.absolute-position.y;DiagnosticReveal.height=self.height;DiagnosticReveal.request+=1;
                                    }
                                }
                            }
                            HorizontalLayout{spacing:8px;
                                ActionButton{text:root.diagnostic-start-label;action-id:"device.network.diagnose";argument:root.diagnostic-start-args;disabled:root.diagnostic-start-disabled;}
                                if root.diagnostic-own && root.diagnostic-busy:ActionButton{text:root.diagnostic-cancel-label;action-id:"device.network.cancel";argument:root.diagnostic-cancel-args;disabled:!root.diagnostic-can-cancel;}
                                if root.diagnostic-details-visible:ActionButton{text:root.diagnostic-details-expanded ? "收起详情" : "查看详情";action-id:"device.network.details.toggle";argument:root.diagnostic-details-args;}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if root.diagnostic-details-visible && root.diagnostic-details-expanded:Text{text:root.network-report;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            Text{text:"连接顺序";color:Palette.ink;}
                            for route in root.network-routes: ReorderDrop{height:52px;order-scope:"routes";item-id:route.key;accept-drop:route.enabled;
                              HorizontalLayout{spacing:10px;padding-left:34px;
                                CheckBox{text:route.label;checked <=> route.enabled;enabled:!route.toggle-blocked;accessible-label:"连接路径："+route.label;toggled=>{Commands.trigger("settings.route.toggle",route.key);}}
                                Rectangle{horizontal-stretch:1;}
                              }
                              DragHandle{x:0px;y:7px;width:28px;height:38px;order-scope:"routes";item-id:route.key;label:"拖动连接路径 "+route.label+" 排序";action-id:"settings.route.move";context:root.profile-draft-id;disabled:!route.enabled || root.sync-busy;}
                            }
                            Text{text:"至少启用一条连接路径。";color:Palette.muted;font-size:12px;}
                            ActionButton{text:"恢复默认顺序";action-id:"settings.set";argument:"routeOrder=default";}
                            Text{text:"中继服务器";color:Palette.ink;}
                            relay-edit:=ProfileErrorEditor{field-key:"relayUrl";text <=> root.relay-url;accessible-label:"中继服务器";placeholder-text:"https://relay.example.com";edited(value)=>{Commands.trigger("settings.network.edit","relayUrl="+value);}}
                            Text{text:"按顺序尝试已启用的路径；同类路径按实测质量选择。更改随本设备连接配置同步。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                        }
                        if root.profile-tab=="video":VerticalLayout {spacing:6px;
                            if !root.narrow-profile:HorizontalLayout{spacing:6px;
                                ActionButton{text:"720P";chosen:root.profile-width==1280 && root.profile-height==720;action-id:"settings.set";argument:"resolution=1280x720";}
                                ActionButton{text:"1080P";chosen:root.profile-width==1920 && root.profile-height==1080;action-id:"settings.set";argument:"resolution=1920x1080";}
                                ActionButton{text:"1440P";chosen:root.profile-width==2560 && root.profile-height==1440;action-id:"settings.set";argument:"resolution=2560x1440";}
                                ActionButton{text:"平板";chosen:root.profile-width==2520 && root.profile-height==1680;action-id:"settings.set";argument:"resolution=2520x1680";}
                                ActionButton{text:"4K";chosen:root.profile-width==3840 && root.profile-height==2160;action-id:"settings.set";argument:"resolution=3840x2160";}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if root.narrow-profile:VerticalLayout{spacing:6px;
                                HorizontalLayout{spacing:6px;ActionButton{text:"720P";chosen:root.profile-width==1280 && root.profile-height==720;action-id:"settings.set";argument:"resolution=1280x720";}ActionButton{text:"1080P";chosen:root.profile-width==1920 && root.profile-height==1080;action-id:"settings.set";argument:"resolution=1920x1080";}ActionButton{text:"1440P";chosen:root.profile-width==2560 && root.profile-height==1440;action-id:"settings.set";argument:"resolution=2560x1440";}Rectangle{horizontal-stretch:1;}}
                                HorizontalLayout{spacing:6px;ActionButton{text:"平板";chosen:root.profile-width==2520 && root.profile-height==1680;action-id:"settings.set";argument:"resolution=2520x1680";}ActionButton{text:"4K";chosen:root.profile-width==3840 && root.profile-height==2160;action-id:"settings.set";argument:"resolution=3840x2160";}Rectangle{horizontal-stretch:1;}}
                            }
                        }
                        for field in root.profile-fields: VerticalLayout{spacing:6px;
                            if root.narrow-profile:Text{text:field.label;color:Palette.ink;wrap:word-wrap;}
                            HorizontalLayout{spacing:16px;
                                if !root.narrow-profile:Text{text:field.label;color:Palette.ink;vertical-alignment:center;}
                                if !root.narrow-profile:Rectangle{horizontal-stretch:1;}
                                if field.kind=="bool": ActionButton{text:field.flag ? "开启" : "关闭";chosen:field.flag;action-id:"settings.set";argument:field.key+"=toggle";accessible-label:field.label+"："+self.text;}
                                if field.kind=="number": HorizontalLayout {spacing:6px;horizontal-stretch:0;
                                    ActionButton{text:"−";action-id:"settings.step";argument:field.key+"|down";disabled:field.disabled;accessible-label:"减少"+field.label;}
                                    Rectangle {width:92px;height:38px;border-width:field.invalid ? 2px : 0px;border-radius:6px;border-color:Palette.failure;
                                        ProfileErrorEditor{field-key:field.key;width:parent.width;height:parent.height;enabled:!field.disabled;text <=> field.input-text;accessible-label:field.label;edited(value)=>{Commands.trigger("settings.input",field.key+"="+value);}}
                                    }
                                    ActionButton{text:"＋";action-id:"settings.step";argument:field.key+"|up";disabled:field.disabled;accessible-label:"增加"+field.label;}
                                }
                                if field.kind=="select": field-choice:=ComboBox{model:field.option-labels;current-index <=> field.selected-index;width:200px;horizontal-stretch:0;accessible-label:field.label;selected(value)=>{Commands.trigger("settings.set",field.key+"="+field.option-values[self.current-index]);}}
                                if root.narrow-profile:Rectangle{horizontal-stretch:1;}
                            }
                            if field.help!="": Text{text:field.help;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                        }
                        if root.profile-tab=="audio": Text{text:"主机 Sunshine 需启用音频捕获。串流中可随时切换声音和音量。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                    }
                    if root.page=="global-settings": VerticalLayout {spacing:20px;vertical-stretch:0;
                        if root.settings-tab=="appearance": VerticalLayout{spacing:16px;
                            Text{text:"主题";color:Palette.ink;font-size:18px;font-weight:600;}
                            HorizontalLayout{spacing:16px;ThemePreview{dark-preview:false;chosen:!root.dark;}ThemePreview{dark-preview:true;chosen:root.dark;}}
                        }
                        if root.settings-tab=="sync": SettingsCard {
                            Text{text:"WebDAV";color:Palette.ink;font-size:18px;font-weight:600;}
                            Text{text:root.sync-last;color:Palette.muted;font-size:12px;}
                            HorizontalLayout{spacing:10px;
                                ActionButton{text:root.sync-busy ? root.sync-progress-text : root.sync-conflict-items.length>0 ? "重新同步" : "立即同步";primary:!root.sync-dirty && root.sync-conflict-items.length==0;action-id:"sync.run";disabled:root.sync-busy || !root.sync-has-password;}
                                ActionButton{text:"移除同步设置";action-id:"sync.clear";disabled:root.sync-busy || !root.sync-has-password;}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if root.sync-conflict-items.length>0: VerticalLayout{spacing:12px;
                                Text{text:root.sync-conflict-items.length+" 项配置存在冲突。选择保留哪一端的冲突项，其余改动会合并。";color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                HorizontalLayout{spacing:10px;ActionButton{text:"冲突项保留本机";action-id:"sync.resolve";argument:root.sync-review-id=="" ? "local" : "local|"+root.sync-review-id;disabled:root.sync-busy;}ActionButton{text:"冲突项保留远端";action-id:"sync.resolve";argument:root.sync-review-id=="" ? "remote" : "remote|"+root.sync-review-id;disabled:root.sync-busy;}Rectangle{horizontal-stretch:1;}}
                                for item in root.sync-conflict-items: Rectangle{border-radius:12px;border-width:1px;border-color:Palette.line;background:Palette.soft;vertical-stretch:0;
                                    VerticalLayout{padding:14px;spacing:6px;
                                        Text{text:item.label;color:Palette.ink;wrap:word-wrap;font-size:14px;font-weight:600;}
                                        if item.fields.length>0:VerticalLayout{spacing:12px;
                                            HorizontalLayout{spacing:16px;Text{text:"本机";color:Palette.ink;font-weight:600;font-size:13px;min-width:0px;preferred-width:0px;horizontal-stretch:1;}Text{text:"远端";color:Palette.ink;font-weight:600;font-size:13px;min-width:0px;preferred-width:0px;horizontal-stretch:1;}}
                                            for field in item.fields:VerticalLayout{spacing:6px;
                                                Text{text:field.label;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                                                HorizontalLayout{spacing:16px;
                                                    Text{text:field.local;accessible-id:"sync-review-local|"+item.key+"|"+field.key;accessible-label:self.text;color:Palette.ink;wrap:word-wrap;font-size:14px;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
                                                    Text{text:field.remote;accessible-id:"sync-review-remote|"+item.key+"|"+field.key;accessible-label:self.text;color:Palette.ink;wrap:word-wrap;font-size:14px;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
                                                }
                                            }
                                        }
                                        if item.fields.length==0:Text{text:"本机："+item.local;color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                        if item.fields.length==0:Text{text:"远端："+item.remote;color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                    }
                                }
                            }
                            Text{text:"目录地址（HTTP / HTTPS）";color:Palette.muted;}
                            dav-url:=LineEdit{enabled:!root.sync-busy;text <=> root.sync-url;accessible-label:"WebDAV 目录地址（HTTP / HTTPS）";placeholder-text:"https://example.com/dav/RHRemote/";edited(value)=>{Commands.trigger("sync.edit","url="+value);}}
                            Text{text:"用户名";color:Palette.muted;}
                            dav-user:=LineEdit{enabled:!root.sync-busy;text <=> root.sync-username;accessible-label:"WebDAV 用户名";edited(value)=>{Commands.trigger("sync.edit","username="+value);}}
                            Text{text:"密码";color:Palette.muted;}
                            dav-password:=LineEdit{enabled:!root.sync-busy;in property <int> generation:root.sync-generation;changed generation=>{self.text="";}input-type:password;accessible-label:"WebDAV 密码";placeholder-text:root.sync-password-reusable ? "已保存，留空保留" : "请填写 WebDAV 密码";edited(value)=>{Commands.trigger("sync.edit","password="+value);}}
                            if root.sync-has-password && !root.sync-password-reusable:Text{text:"地址或用户名已更改，请重新填写密码。";accessible-label:self.text;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            HorizontalLayout{
                                dav-auto:=CheckBox{enabled:!root.sync-busy;text:"自动同步";checked <=> root.sync-automatic;toggled=>{Commands.trigger("sync.edit","automatic="+(self.checked ? "true" : "false"));}}
                                dav-interval:=ComboBox{enabled:!root.sync-busy;model:["5 分钟","15 分钟","30 分钟","60 分钟"];current-index <=> root.sync-interval-index;preferred-width:150px;horizontal-stretch:0;accessible-label:"自动同步间隔";selected(value)=>{Commands.trigger("sync.edit","intervalMinutes="+(self.current-index==0?"5":self.current-index==1?"15":self.current-index==2?"30":"60"));}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            Text{text:"同步设备列表、各客户端的连接配置和主题。各端只使用自己的配置；其他端的配置可手动复制。配对密钥及本机凭据不参与同步。";color:Palette.muted;wrap:word-wrap;font-size:12px;}
                        }
                        if root.settings-tab=="proxy": SettingsCard {
                            Text{text:"代理";color:Palette.ink;font-size:18px;font-weight:600;}
                            CheckBox{text:"启用代理";checked <=> root.proxy-enabled;enabled:!root.proxy-busy;toggled=>{Commands.trigger("proxy.edit","enabled="+(self.checked?"true":"false"));}}
                            if !root.narrow-profile:HorizontalLayout{spacing:12px;
                                proxy-protocol:=ComboBox{model:["HTTP","HTTPS"];current-index <=> root.proxy-protocol-index;enabled:!root.proxy-busy;preferred-width:110px;horizontal-stretch:0;accessible-label:"代理协议";selected(value)=>{Commands.trigger("proxy.edit","protocol="+(self.current-index==1?"https":"http"));}}
                                proxy-host-input:=LineEdit{text <=> root.proxy-host;enabled:!root.proxy-busy;accessible-label:"代理地址";horizontal-stretch:1;edited=>{Commands.trigger("proxy.edit","host="+self.text);}}
                                proxy-port-input:=LineEdit{text <=> root.proxy-port;enabled:!root.proxy-busy;accessible-label:"代理端口";preferred-width:90px;horizontal-stretch:0;edited=>{Commands.trigger("proxy.edit","port="+self.text);}}
                            }
                            if root.narrow-profile:VerticalLayout{spacing:12px;
                                proxy-protocol-narrow:=ComboBox{model:["HTTP","HTTPS"];current-index <=> root.proxy-protocol-index;enabled:!root.proxy-busy;accessible-label:"代理协议";selected(value)=>{Commands.trigger("proxy.edit","protocol="+(self.current-index==1?"https":"http"));}}
                                proxy-host-narrow:=LineEdit{text <=> root.proxy-host;enabled:!root.proxy-busy;accessible-label:"代理地址";edited=>{Commands.trigger("proxy.edit","host="+self.text);}}
                                proxy-port-narrow:=LineEdit{text <=> root.proxy-port;enabled:!root.proxy-busy;accessible-label:"代理端口";edited=>{Commands.trigger("proxy.edit","port="+self.text);}}
                            }
                            Text{text:"应用范围";color:Palette.ink;}
                            CheckBox{text:"更新";checked <=> root.proxy-updates;enabled:!root.proxy-busy;toggled=>{Commands.trigger("proxy.edit","updates="+(self.checked?"true":"false"));}}
                            CheckBox{text:"配置同步";checked <=> root.proxy-sync;enabled:!root.proxy-busy;toggled=>{Commands.trigger("proxy.edit","sync="+(self.checked?"true":"false"));}}
                            CheckBox{text:"远程连接";checked <=> root.proxy-remote;enabled:!root.proxy-busy;toggled=>{Commands.trigger("proxy.edit","remote="+(self.checked?"true":"false"));}}
                            Text{text:"远程连接使用 RHRemote 中继隧道，代理不可用时报告错误。代理设置仅保存在本机，保存后生效。";color:Palette.muted;wrap:word-wrap;font-size:13px;}
                            if root.proxy-busy:Text{text:"请先结束连接、同步或更新操作，再修改代理。";color:Palette.muted;wrap:word-wrap;}
                            if root.proxy-error!="":Text{text:root.proxy-error;color:Palette.failure;wrap:word-wrap;}
                            HorizontalLayout{spacing:12px;ActionButton{text:"保存";action-id:"proxy.save";disabled:root.proxy-busy||!root.proxy-dirty;}ActionButton{text:"取消";action-id:"proxy.cancel";disabled:root.proxy-busy||!root.proxy-dirty;}Text{text:root.proxy-dirty?"有未保存的更改":"设置已保存";color:Palette.muted;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}}
                        }
                        if root.settings-tab=="updates": SettingsCard {
                            HorizontalLayout {spacing:16px;
                                Image {source:@image-url("../../../shared/icons/rhremote.svg");width:48px;height:48px;}
                                VerticalLayout {spacing:5px;Text{text:"RHRemote";color:Palette.ink;font-size:22px;font-weight:600;}Text{text:"Moonlight · "+root.app-version;color:Palette.muted;font-size:13px;}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            HorizontalLayout {spacing:16px;
                                Text{text:"首选更新源";color:Palette.ink;vertical-alignment:center;}
                                update-source:=ComboBox{model:["CNB","GitHub"];current-index <=> root.update-source-index;preferred-width:180px;horizontal-stretch:0;enabled:!root.updates-busy;accessible-label:"首选更新源";selected(value)=>{Commands.trigger("updates.source.set","source="+(self.current-index==1?"github":"cnb"));}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            Text{text:root.updates-managed ? "首选源不可用时自动尝试另一来源。" : "当前为开发预览版，应用内更新仅在正式安装版中可用。";color:Palette.muted;wrap:word-wrap;}
                            if root.updates-available: Text{text:"可用版本："+root.update-version;color:Palette.ink;}
                            if root.update-notes!="":ReleaseNotes{blocks:root.update-note-blocks;}
                            if root.updates-busy: Rectangle {height:4px;background:Palette.line;border-radius:2px;
                                Rectangle {height:parent.height;width:parent.width * (root.update-phase=="downloading" ? root.update-progress / 100 : 0.12);background:Palette.blue;border-radius:2px;}
                            }
                            Text{text:root.update-phase=="error" ? "更新失败，请重试。" : root.update-status;color:root.update-phase=="error" ? Palette.failure : Palette.muted;wrap:word-wrap;font-size:14px;}
                            if root.update-phase=="error":HorizontalLayout{ActionButton{text:root.update-details ? "收起详情" : "查看详情";action-id:"updates.details.toggle";chosen:root.update-details;}Rectangle{horizontal-stretch:1;}}
                            if root.update-phase=="error" && root.update-details:Text{text:root.update-status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            Text{text:root.streaming || root.connecting ? "请先断开远程连接再安装更新。" : "安装时会重启 RHRemote。";color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            Rectangle{height:1px;background:Palette.line;}
                            HorizontalLayout{ActionButton{text:root.update-history-expanded?"收起历史更新记录":"历史更新记录";action-id:"updates.history.toggle";chosen:root.update-history-expanded;}Rectangle{horizontal-stretch:1;}}
                            if root.update-history-expanded:VerticalLayout{spacing:16px;
                                if root.update-history-busy:Text{text:"正在加载历史更新记录…";color:Palette.muted;wrap:word-wrap;}
                                if root.update-history-error!="":Text{text:root.update-history-error;color:Palette.failure;wrap:word-wrap;}
                                HorizontalLayout{ActionButton{text:root.update-history-error!=""?"重试加载历史记录":"刷新历史记录";action-id:"updates.history.refresh";disabled:root.update-history-busy;}Rectangle{horizontal-stretch:1;}}
                                for release in root.update-history:VerticalLayout{spacing:10px;
                                    ActionButton{text:"";accessible-label:"v"+release.version;action-id:"updates.history.entry.toggle";argument:release.version;chosen:release.expanded;horizontal-stretch:1;min-width:0px;height:self.width<460px ? 76px : 58px;
                                        if self.width>=460px:HorizontalLayout{padding:14px;spacing:24px;Text{text:"v"+release.version;color:Palette.ink;font-weight:600;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}Text{text:release.published;color:Palette.muted;vertical-alignment:center;wrap:word-wrap;font-size:12px;max-width:240px;}Image{source:release.expanded?@image-url("icons/chevron-up.svg"):@image-url("icons/chevron-down.svg");width:16px;height:16px;}}
                                        if self.width<460px:HorizontalLayout{padding:14px;spacing:16px;VerticalLayout{spacing:8px;Text{text:"v"+release.version;color:Palette.ink;font-weight:600;}Text{text:release.published;color:Palette.muted;wrap:word-wrap;font-size:12px;}}Image{source:release.expanded?@image-url("icons/chevron-up.svg"):@image-url("icons/chevron-down.svg");width:16px;height:16px;}}
                                    }
                                    if release.expanded:ReleaseNotes{blocks:release.blocks;}
                                }
                                if root.update-history.length==0 && !root.update-history-busy:Text{text:"暂无历史更新记录";color:Palette.muted;}
                            }
                        }
                        if root.settings-tab=="about": VerticalLayout{spacing:16px;
                            SettingsCard {HorizontalLayout{spacing:16px;Image{source:@image-url("../../../shared/icons/rhremote.svg");width:48px;height:48px;}VerticalLayout{spacing:5px;Text{text:"RHRemote";font-size:22px;font-weight:600;color:Palette.ink;}Text{text:"Moonlight · "+root.app-version;color:Palette.muted;font-size:13px;}}Rectangle{horizontal-stretch:1;}}}
                            SettingsCard {Text{text:"开源组件";font-size:16px;font-weight:600;color:Palette.ink;}HorizontalLayout{Text{text:"客户端核心";width:100px;color:Palette.muted;font-size:13px;}Text{text:"Moonlight";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}HorizontalLayout{Text{text:"服务端";width:100px;color:Palette.muted;font-size:13px;}Text{text:"Sunshine";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}HorizontalLayout{Text{text:"许可证";width:100px;color:Palette.muted;font-size:13px;}Text{text:"GPL v3";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}}
                            SettingsCard {
                            Text{text:"诊断";font-size:16px;font-weight:600;color:Palette.ink;}
                            HorizontalLayout{Text{text:"连接统计";color:Palette.ink;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}ActionButton{text:root.test-mode?"测试统计：开启":"测试统计：关闭";action-id:"statistics.configure";argument:root.test-mode?"false":"true";chosen:root.test-mode;disabled:root.streaming||root.connecting;}}
                            Text{text:"测试模式每次连接记录阶段和逐帧时间。分析后自动清理原始记录。";color:Palette.muted;wrap:word-wrap;}
                            if root.trace-path!="": Text{text:root.trace-path;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            }
                        }
                    }
                    if root.page=="device-info":SettingsCard {
                        Text{text:"设备名称";color:Palette.ink;font-size:14px;}
                        info-editor:=LineEdit{init=>{self.focus();}text <=> root.info-name;placeholder-text:root.selected-device.host-name;accessible-label:"设备名称";enabled:!root.sync-busy;edited(value)=>{Commands.trigger("device.info.input",value);}accepted=>{Commands.trigger("device.info.save","");}}
                        if root.info-error!="":Text{text:root.info-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                        Text{text:"留空使用主机名。显示名称随设备配置同步。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        HorizontalLayout{ActionButton{text:"恢复原名";action-id:"device.info.reset";disabled:root.info-name=="";}Rectangle{horizontal-stretch:1;}}
                        Rectangle{height:1px;background:Palette.line;}
                        DetailField{label:"主机名";value:root.selected-device.host-name;}
                        Text{text:"设备标识";color:Palette.muted;font-size:12px;}
                        Text{text:root.selected-uuid;color:Palette.ink;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="add": SettingsCard {
                        Text{text:"IP 或主机名，支持局域网、Tailscale 和公网地址";color:Palette.muted;wrap:word-wrap;}
                        Text{text:"设备地址";color:Palette.ink;font-size:14px;}
                        address:=LineEdit {init=>{self.focus();}text <=> root.add-address;enabled:!root.add-busy;accessible-label:"设备地址";placeholder-text:"例如 192.168.0.104 或 100.x.x.x";edited(value)=>{Commands.trigger("device.add.input",value);}accepted=>{Commands.trigger("device.add.submit",self.text);}}
                        if root.sync-busy:Text{text:"配置正在同步，完成后可添加设备。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.add-error!="":Text{text:root.add-error;color:Palette.failure;wrap:word-wrap;font-size:13px;}
                        if root.add-busy:VerticalLayout{spacing:12px;
                            ProgressIndicator{indeterminate:true;}
                            Text{text:"正在查找设备…";color:Palette.muted;font-size:13px;}
                        }
                        Text{text:"找到设备后会保存到远程设备列表，配对在设备详情中完成。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="connection": VerticalLayout{spacing:22px;vertical-stretch:0;
                        HorizontalLayout{spacing:14px;
                            Rectangle{width:48px;height:48px;background:Palette.soft;border-radius:12px;
                                Image{source:@image-url("icons/monitor.svg");width:26px;height:26px;x:11px;y:11px;}
                            }
                            VerticalLayout{spacing:6px;alignment:center;
                                Text{text:root.connection-name;color:Palette.ink;font-size:24px;font-weight:600;overflow:elide;}
                                Text{text:root.connection-title;color:root.connection-phase=="failed" ? Palette.failure : Palette.muted;font-size:14px;wrap:word-wrap;}
                            }
                        }
                        if !root.connection-busy && root.connection-operation=="connect" && (root.connection-phase=="ended" || root.connection-phase=="cancelled" || root.connection-phase=="failed"):HorizontalLayout{alignment:start;
                            ActionButton{text:root.connection-phase=="failed" ? "重试连接" : "再次连接";action-id:"connection.retry";primary:true;disabled:root.control-requests-pending;}
                        }
                        if root.connection-busy && root.connection-phase!="connected":ProgressIndicator{indeterminate:true;}
                        if root.connection-operation!="pair" && root.connection-busy && root.connection-phase!="connected":Rectangle{
                            background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;preferred-height:conn-stepper.preferred-height;clip:true;
                            Rectangle{x:0px;y:0px;width:parent.width;height:3px;background:@linear-gradient(90deg, Palette.blue 0%, Palette.purple 100%);}
                            conn-stepper:=VerticalLayout{padding:18px;spacing:10px;
                                Rectangle{height:38px;border-radius:8px;background:root.connection-phase=="resolving" ? Palette.soft : transparent;border-width:root.connection-phase=="resolving" ? 1px : 0px;border-color:Palette.blue;
                                    HorizontalLayout{padding-left:12px;padding-right:12px;spacing:10px;
                                        Text{text:"1  检查地址与配对";color:root.connection-phase=="resolving" ? Palette.blue : Palette.muted;font-size:14px;font-weight:root.connection-phase=="resolving" ? 600 : 400;vertical-alignment:center;}
                                        Rectangle{horizontal-stretch:1;}
                                    }
                                }
                                Rectangle{height:38px;border-radius:8px;background:root.connection-phase=="starting" ? Palette.soft : transparent;border-width:root.connection-phase=="starting" ? 1px : 0px;border-color:Palette.blue;
                                    HorizontalLayout{padding-left:12px;padding-right:12px;spacing:10px;
                                        Text{text:"2  建立串流";color:root.connection-phase=="starting" ? Palette.blue : Palette.muted;font-size:14px;font-weight:root.connection-phase=="starting" ? 600 : 400;vertical-alignment:center;}
                                        Rectangle{horizontal-stretch:1;}
                                    }
                                }
                                Rectangle{height:38px;border-radius:8px;background:root.connection-phase=="first-frame" || root.connection-phase=="connected" ? Palette.soft : transparent;border-width:root.connection-phase=="first-frame" || root.connection-phase=="connected" ? 1px : 0px;border-color:Palette.blue;
                                    HorizontalLayout{padding-left:12px;padding-right:12px;spacing:10px;
                                        Text{text:"3  显示远程画面";color:root.connection-phase=="first-frame" || root.connection-phase=="connected" ? Palette.blue : Palette.muted;font-size:14px;font-weight:root.connection-phase=="first-frame" || root.connection-phase=="connected" ? 600 : 400;vertical-alignment:center;}
                                        Rectangle{horizontal-stretch:1;}
                                    }
                                }
                            }
                        }
                        if root.connection-error!="":Text{text:root.connection-error;color:Palette.failure;font-size:14px;wrap:word-wrap;}
                        if root.control-requests-pending:Text{text:"正在结束上一项会话操作…";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.connection-phase=="connected":Text{text:"会话控制位于远程画面上方。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="pair": VerticalLayout {spacing:22px;
                        Text{text:root.connection-title;color:Palette.ink;font-size:22px;wrap:word-wrap;}
                        if root.connection-busy && root.pair-pin=="":pair-progress:=ProgressIndicator{indeterminate:true;}
                        Text{text:root.pair-pin=="" ? (root.connection-phase=="preparing" ? "正在选择可用线路，完成后显示配对码。" : "正在启动主机配对，完成后显示配对码。") : "请在这台电脑的 RHRemote-Sunshine 管理界面输入配对码：";color:Palette.muted;wrap:word-wrap;}
                        if root.pair-pin!="":Rectangle{
                            background:Palette.surface;border-radius:14px;border-width:1.5px;border-color:Palette.blue;preferred-height:pin-box.preferred-height;max-width:340px;clip:true;
                            Rectangle{x:0px;y:0px;width:parent.width;height:3px;background:@linear-gradient(90deg, Palette.blue 0%, Palette.purple 100%);}
                            pin-box:=VerticalLayout{padding:22px;spacing:8px;alignment:center;
                                Text{text:"SUNSHINE 安全配对码";color:Palette.muted;font-size:11px;font-weight:600;horizontal-alignment:center;}
                                Rectangle{background:Palette.soft;border-radius:10px;padding:12px;preferred-height:68px;
                                    Text{text:root.pair-pin;color:Palette.blue;font-size:44px;font-weight:700;horizontal-alignment:center;vertical-alignment:center;}
                                }
                            }
                        }
                    }
                    if root.page!="settings" && root.page!="global-settings" && root.page!="add" && root.page!="device-info" && root.page!="connection" && root.page!="pair" && root.page!="profile-copy" && root.status!="": Text{text:root.status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                    Rectangle {min-height:12px;vertical-stretch:1;}

            Text{text:"基于 Moonlight 开源核心 · GPL v3";color:Palette.muted;font-size:11px;}
                }
            }
            if root.page=="global-settings" && root.settings-tab=="updates":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:update-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                update-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Text{text:!root.updates-managed ? "此启动方式不支持更新，请使用安装版或便携版。" : root.update-primary-installs ? root.update-install-hint : "";color:Palette.muted;font-size:12px;wrap:word-wrap;min-width:0px;preferred-width:0px;horizontal-stretch:1;vertical-alignment:center;}
                    ActionButton{text:root.update-primary-text;action-id:"updates.primary";argument:root.update-intent;primary:true;disabled:root.updates-busy || !root.updates-managed || (root.update-primary-installs && (root.streaming || root.connecting || root.update-install-hint!=""));}
                    if root.update-can-cancel || root.update-cancelling:ActionButton{text:"取消";action-id:"updates.cancel";argument:root.update-operation;disabled:root.update-cancelling;}
                }
            }
            if (root.page=="connection" || root.page=="pair") && (root.connection-busy || root.navigation-hint!="" || (root.connection-operation=="pair" && root.connection-phase=="failed")):Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:connection-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                connection-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Text{text:root.navigation-hint;color:Palette.muted;font-size:12px;wrap:word-wrap;vertical-alignment:center;horizontal-stretch:1;}
                    if root.connection-busy:ActionButton{text:root.connection-phase=="cancelling" || root.connection-phase=="cleaning" ? "正在清理…" : root.connection-operation=="pair" ? "取消配对" : root.connection-phase=="connected" ? "断开连接" : "取消连接";action-id:root.connection-operation=="pair" ? "pair.cancel" : "stream.disconnect";disabled:root.connection-phase=="cancelling" || root.connection-phase=="cleaning";}
                    if !root.connection-busy && root.connection-phase=="failed" && root.connection-operation=="pair":ActionButton{text:"重试配对";action-id:"connection.retry";primary:true;disabled:root.control-requests-pending;}
                }
            }
            if root.page=="profile-copy":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:copy-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                copy-footer:=VerticalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.copy-error!="":Text{text:root.copy-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                    HorizontalLayout{spacing:10px;Rectangle{horizontal-stretch:1;}ActionButton{text:"取消";action-id:"settings.copy.cancel";}ActionButton{text:"复制到草稿";action-id:"settings.copy.apply";primary:true;disabled:root.copy-source=="";}}
                }
            }
            if root.page=="settings": Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:profile-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                profile-footer:=VerticalLayout {padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.settings-error!="": SaveErrorDetails{message:root.settings-error;test-id:"scroll|profile-error";}
                    HorizontalLayout {spacing:10px;
                        Text{text:root.copy-notice!="" ? root.copy-notice : root.settings-dirty ? "有未保存的更改" : "设置已保存";color:Palette.muted;font-size:12px;vertical-alignment:center;overflow:elide;}
                        Rectangle{horizontal-stretch:1;}
                        ActionButton{text:"取消";action-id:"settings.cancel";}
                        ActionButton{text:"保存";action-id:"settings.save";primary:true;disabled:!root.settings-dirty;}
                    }
                }
            }
            if root.page=="device-info":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:info-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                info-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Text{text:root.info-dirty ? "有未保存的更改" : "";color:Palette.muted;font-size:12px;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}ActionButton{text:"取消";action-id:"device.info.cancel";}
                    ActionButton{text:"完成";action-id:"device.info.save";primary:true;disabled:root.sync-busy;}
                }
            }
            if root.page=="add":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:add-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                add-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:"取消";action-id:"device.add.cancel";}
                    ActionButton{text:root.add-busy ? "正在查找…" : "添加";action-id:"device.add.submit";argument:root.add-address;primary:true;disabled:root.add-busy || root.sync-busy || root.add-address=="";}
                }
            }
            if root.page=="global-settings" && root.settings-tab=="sync": Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:sync-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                sync-footer:=VerticalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.sync-error!="":SaveErrorDetails{message:root.sync-error;test-id:"scroll|sync-error";}
                    HorizontalLayout{spacing:10px;
                        Text{text:root.sync-dirty ? "有未保存的更改" : root.sync-has-password ? "设置已保存" : "未配置";color:Palette.muted;vertical-alignment:center;font-size:12px;}
                        Rectangle{horizontal-stretch:1;}
                        ActionButton{text:"取消";action-id:"sync.cancel";disabled:root.sync-busy || !root.sync-dirty;}
                        ActionButton{text:"保存";primary:true;action-id:"sync.save";disabled:root.sync-busy || !root.sync-dirty;}
                    }
                }
            }

            if root.diagnostic-banner:Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:diagnostic-banner.preferred-height;
                Rectangle{x:0px;y:0px;height:1px;width:parent.width;background:Palette.line;}
                diagnostic-banner:=HorizontalLayout{padding:16px;spacing:12px;
                    Text{text:root.diagnostic-banner-text;color:root.diagnostic-banner-failed ? Palette.failure : Palette.muted;vertical-alignment:center;font-size:12px;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;accessible-label:root.diagnostic-banner-text;}
                    ActionButton{text:root.diagnostic-cancel-label;action-id:"device.network.cancel";argument:root.diagnostic-cancel-args;disabled:!root.diagnostic-can-cancel;}
                }
            }
        }
        }
    }
    if root.window-picker-open: Rectangle {background:#0006;
        TouchArea{}
        Rectangle {width:min(parent.width - 32px,640px);height:min(parent.height - 48px,560px);x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Palette.surface;border-radius:12px;
            init=>{root.window-picker-choice=0;window-close.focus();}
            VerticalLayout {padding:20px;spacing:12px;
                HorizontalLayout {Text{text:"选择窗口";color:Palette.ink;font-size:22px;font-weight:600;}Rectangle{horizontal-stretch:1;}window-close:=ActionButton{text:root.window-picker-busy ? "取消请求" : "关闭";action-id:"device.windows.close";chosen:root.window-picker-choice==0;focused-in=>{root.window-picker-choice=0;}}}
                Text{text:"预览功能：连接后先点击窗口激活输入。独立弹窗需要另选；关闭或最小化后停止。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                if root.window-picker-busy:Text{text:"正在读取窗口列表…";color:Palette.muted;}
                if root.window-picker-error!="":Text{text:root.window-picker-error;color:Palette.failure;wrap:word-wrap;}
                ScrollView {vertical-stretch:1;
                    VerticalLayout {spacing:8px;
                        for row[index] in root.window-picker-rows:ActionButton{text:row.label;elide-text:true;action-id:"device.window.connect";argument:root.window-picker-uuid+"|"+row.id;disabled:root.window-picker-busy || !row.available;min-width:0px;preferred-width:0px;horizontal-stretch:1;height:56px;chosen:root.window-picker-choice==index+1;focused-in=>{root.window-picker-choice=index+1;}}
                        if !root.window-picker-busy && root.window-picker-rows.length==0:Text{text:"没有可采集的窗口";color:Palette.muted;wrap:word-wrap;}
                    }
                }
                HorizontalLayout {Rectangle{horizontal-stretch:1;}ActionButton{text:"刷新";action-id:"device.windows.open";argument:root.window-picker-uuid;disabled:root.window-picker-busy;chosen:root.window-picker-choice==root.window-picker-rows.length+1;focused-in=>{root.window-picker-choice=root.window-picker-rows.length+1;}}}
            }
        }
    }
    if root.sync-clear-prompt: Rectangle {background:#0006;
        TouchArea{}
        Rectangle {width:min(parent.width - 32px,480px);height:clear-decision.preferred-height;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Palette.surface;border-radius:12px;
            in property <int> selected-choice:root.sync-clear-choice;
            init=>{clear-cancel.focus();}
            changed selected-choice=>{if(self.selected-choice==0){clear-cancel.focus();}else{clear-confirm.focus();}}
            clear-decision:=VerticalLayout {padding:24px;spacing:18px;
                Text{text:"移除同步设置？";color:Palette.ink;font-size:22px;font-weight:600;}
                Text{text:"仅移除此设备保存的 WebDAV 地址和登录信息，并关闭自动同步。本机远程设备和服务器上的配置文件保留。";color:Palette.muted;wrap:word-wrap;font-size:14px;}
                if root.sync-error!="":Text{text:root.sync-error;color:Palette.failure;wrap:word-wrap;font-size:13px;}
                HorizontalLayout {spacing:8px;Rectangle{horizontal-stretch:1;}clear-cancel:=ActionButton{focused-in=>{root.sync-clear-choice=0;}text:"取消";action-id:"sync.clear.resolve";argument:"cancel";chosen:root.sync-clear-choice==0;disabled:root.sync-busy;}clear-confirm:=ActionButton{focused-in=>{root.sync-clear-choice=1;}text:"移除";action-id:"sync.clear.resolve";argument:"remove";chosen:root.sync-clear-choice==1;disabled:root.sync-busy;}}
            }
        }
    }
    if root.navigation-prompt: Rectangle {background:#0006;
        TouchArea{}
        Rectangle {width:min(parent.width - 32px,480px);height:decision.preferred-height + 48px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Palette.surface;border-radius:12px;
            in property <int> selected-choice:root.navigation-choice;
            init=>{continue-choice.focus();}
            changed selected-choice=>{if(self.selected-choice==0){continue-choice.focus();}else if(self.selected-choice==1){discard-choice.focus();}else{save-choice.focus();}}
            decision:=VerticalLayout {padding:24px;spacing:18px;
                Text{text:"保存更改？";color:Palette.ink;font-size:22px;font-weight:600;}
                Text{text:root.navigation-message;color:Palette.muted;wrap:word-wrap;font-size:14px;}
                HorizontalLayout {spacing:8px;continue-choice:=ActionButton{focused-in=>{root.navigation-choice=0;}text:"继续编辑";action-id:"navigation.resolve";argument:"stay";chosen:root.navigation-choice==0;}Rectangle{horizontal-stretch:1;}discard-choice:=ActionButton{focused-in=>{root.navigation-choice=1;}text:"放弃更改";action-id:"navigation.resolve";argument:"discard";chosen:root.navigation-choice==1;}save-choice:=ActionButton{focused-in=>{root.navigation-choice=2;}text:"保存并继续";action-id:"navigation.resolve";argument:"save";chosen:root.navigation-choice==2;primary:true;}}
            }
        }
    }

    }
}
