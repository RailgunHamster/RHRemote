component SpinBox inherits BaseSpinBox {
    property <string> test-id:"spin|"+root.accessible-label;
    accessible-id:root.test-id;
    accessible-enabled:root.enabled && !ModalContext.active;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"spinbox",root.accessible-label,root.accessible-enabled,root.has-focus,false,false,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.accessible-enabled){root.focus();}}}
}
component ScrollView inherits BaseScrollView {
    enabled:!ModalContext.active;
    in property <string> test-id;
    UiProbe{control-id:root.test-id;kind:"scroll";control-width:root.width;control-height:root.height;scroll-y:root.content-y;scroll-maximum:max(0px,root.content-height - root.visible-height);scroll-requested(delta)=>{root.content-y=max(-max(0px,root.content-height - root.visible-height),min(0px,root.content-y + delta*1px));}}
}
// Full save errors remain readable without growing the fixed action bar off-screen.
component SaveErrorDetails inherits Rectangle {
    in property <string> message;
    in property <string> test-id;
    preferred-height:min(80px,error-content.preferred-height);min-height:0px;max-height:80px;vertical-stretch:0;
    accessible-role:groupbox;accessible-label:"保存错误详情";
    border-radius:4px;border-width:1px;border-color:error-keys.has-focus && root.available ? Palette.blue : transparent;
    private property <bool> available:!ModalContext.active && error-scroll.content-height>error-scroll.visible-height+1px;
    function scroll-by(delta:length){error-scroll.content-y=max(-max(0px,error-scroll.content-height - error-scroll.visible-height),min(0px,error-scroll.content-y+delta));}
    changed message=>{error-scroll.content-y=0px;}
    forward-focus:error-keys;
    error-keys:=FocusScope {width:root.width;height:root.height;focus-on-click:root.available;focus-on-tab-navigation:root.available;
        key-pressed(event)=>{
            if(root.available){
                if(event.text==Key.DownArrow){root.scroll-by(-32px);return accept;}
                if(event.text==Key.UpArrow){root.scroll-by(32px);return accept;}
                if(event.text==Key.PageDown){root.scroll-by(-max(32px,error-scroll.visible-height - 16px));return accept;}
                if(event.text==Key.PageUp){root.scroll-by(max(32px,error-scroll.visible-height - 16px));return accept;}
                if(event.text==Key.Home){error-scroll.content-y=0px;return accept;}
                if(event.text==Key.End){error-scroll.content-y=-max(0px,error-scroll.content-height - error-scroll.visible-height);return accept;}
            }
            return reject;
        }
        error-scroll:=BaseScrollView {width:parent.width;height:parent.height;enabled:!ModalContext.active;content-width:self.visible-width;horizontal-scrollbar-policy:always-off;
            error-content:=VerticalLayout {padding:0px;Text{text:root.message;accessible-label:root.message;color:Palette.failure;font-size:13px;wrap:word-wrap;}}
        }
    }
    UiProbe{control-id:root.test-id;kind:"scroll";label:"保存错误详情";control-enabled:root.available;focused:error-keys.has-focus;remember-focus:false;control-width:root.width;control-height:root.height;scroll-y:error-scroll.content-y;scroll-maximum:max(0px,error-scroll.content-height - error-scroll.visible-height);focus-requested=>{error-keys.focus();}scroll-requested(delta)=>{root.scroll-by(delta*1px);}}
}
// Session details fill the available body; fixed close/recovery actions stay outside.
component SessionErrorDetails inherits Rectangle {
    in property <string> message;
    in property <string> test-id;
    in property <string> label;
    in property <length> message-font-size:13px;
    min-height:0px;vertical-stretch:1;
    accessible-role:groupbox;accessible-label:root.label;
    border-radius:4px;border-width:1px;border-color:message-keys.has-focus && root.available ? Palette.blue : transparent;
    private property <bool> available:message-scroll.content-height>message-scroll.visible-height+1px;
    function scroll-by(delta:length){message-scroll.content-y=max(-max(0px,message-scroll.content-height - message-scroll.visible-height),min(0px,message-scroll.content-y+delta));}
    changed message=>{message-scroll.content-y=0px;}
    forward-focus:message-keys;
    message-keys:=FocusScope{width:root.width;height:root.height;focus-on-click:root.available;focus-on-tab-navigation:root.available;
        key-pressed(event)=>{
            if(root.available){
                if(event.text==Key.DownArrow){root.scroll-by(-32px);return accept;}
                if(event.text==Key.UpArrow){root.scroll-by(32px);return accept;}
                if(event.text==Key.PageDown){root.scroll-by(-max(32px,message-scroll.visible-height - 16px));return accept;}
                if(event.text==Key.PageUp){root.scroll-by(max(32px,message-scroll.visible-height - 16px));return accept;}
                if(event.text==Key.Home){message-scroll.content-y=0px;return accept;}
                if(event.text==Key.End){message-scroll.content-y=-max(0px,message-scroll.content-height - message-scroll.visible-height);return accept;}
            }
            return reject;
        }
        message-scroll:=BaseScrollView{x:4px;y:4px;width:max(0px,parent.width - 8px);height:max(0px,parent.height - 8px);content-width:self.visible-width;horizontal-scrollbar-policy:always-off;
            VerticalLayout{padding:0px;Text{text:root.message;accessible-label:root.message;color:Palette.failure;font-size:root.message-font-size;wrap:word-wrap;}}
        }
    }
    UiProbe{control-id:root.test-id;kind:"scroll";label:root.label;control-enabled:root.available;focused:message-keys.has-focus;remember-focus:false;control-width:root.width;control-height:root.height;scroll-y:message-scroll.content-y;scroll-maximum:max(0px,message-scroll.content-height - message-scroll.visible-height);focus-requested=>{message-keys.focus();}scroll-requested(delta)=>{root.scroll-by(delta*1px);}}
}
export struct DeviceRow { uuid:string, name:string, host-name:string, address:string, search-addresses:string, status:string, paired:bool, online:bool, is-self:bool, pending:bool, check-retry:bool, check-failed:bool, check-hint:string, repair-required:bool }
export struct ProfileSource { client-id:string, label:string }
export struct CopyField { label:string, value:string }
export struct SyncConflictField { key:string, label:string, local:string, remote:string }
export struct SyncConflictRow { key:string, label:string, local:string, remote:string, fields:[SyncConflictField] }
export struct RemoteDisplay { id:string,label:string,chosen:bool,available:bool }
export struct KeyboardKey { id:string,label:string,description:string,action:string,argument:string,chosen:bool,x:float,y:float,width:float,height:float,draggable:bool }
export struct SettingRow { key:string,label:string,kind:string,help:string,flag:bool,disabled:bool,number:int,input-text:string,invalid:bool,minimum:int,maximum:int,step:int,selected-index:int,option-labels:[string],option-values:[string] }
export struct RouteRow { key:string,label:string,enabled:bool,can-move-up:bool,can-move-down:bool,can-disable:bool,toggle-blocked:bool }
export global Palette {
    in property <bool> dark;
    out property <color> page: dark ? #151b29 : #f6f7fa;
    out property <color> surface: dark ? #1b2232 : #ffffff;
    out property <color> ink: dark ? #e1e8f6 : #34415b;
    out property <color> muted: dark ? #a4b1c8 : #69778e;
    out property <color> line: dark ? #303c53 : #e5eaf4;
    out property <color> blue: dark ? #6f8af1 : #5274e8;
    out property <color> soft: dark ? #253452 : #edf2ff;
    out property <color> purple: dark ? #ba9aef : #8b5be2;
    out property <color> failure: dark ? #f28b9c : #b04452;
    out property <color> success: dark ? #8bc7b1 : #369c81;
}
component ActionButton inherits Rectangle {
    property <bool> available:!root.disabled && (!ModalContext.active || root.action-id==ModalContext.allowed-action);
    private property <bool> press-valid:false;
    private property <string> pressed-action;
    private property <string> pressed-argument;
    private property <string> pressed-text;
    changed action-id=>{root.press-valid=false;}
    changed argument=>{root.press-valid=false;}
    changed text=>{root.press-valid=false;}
    changed available=>{if(!root.available){root.press-valid=false;}}
    function invoke-action(){if(root.available){Commands.trigger(root.action-id,root.argument);}}
    in property <string> text;
    in property <length> font-size:13px;
    in property <string> action-id;
    in property <string> argument;
    in property <bool> elide-text:false;
    in property <bool> primary:false;
    in property <bool> chosen:false;
    in property <bool> disabled:false;
    in property <bool> subtle:false;
    in property <bool> has-icon:false;
    in property <bool> remember-focus:true;
    // Keyboard transparency belongs to the key surface, never to its lettering.
    in property <bool> keyboard-key:false;
    in property <bool> draggable:false;
    in property <string> drag-id;
    in property <float> base-x:0;
    in property <float> base-y:0;
    in property <float> viewport-width:0;
    in property <float> viewport-height:0;
    out property <bool> dragging:false;
    out property <float> drag-dx:0;
    out property <float> drag-dy:0;
    in property <image> icon;
    out property <bool> focused:key-focus.has-focus;
    callback focused-in();
    changed focused=>{if(root.focused){root.focused-in();}}
    min-width: label.preferred-width + 32px + (root.has-icon ? 24px : 0px);
    preferred-width: label.preferred-width + 32px + (root.has-icon ? 24px : 0px);
    horizontal-stretch:0;
    height: 38px;
    border-radius: 8px;
    background: root.keyboard-key ? (root.chosen ? #294c87b0 : touch.pressed ? #294c87c0 : touch.has-hover ? #18202e88 : #18202e50) : root.disabled ? Palette.soft : root.primary ? (touch.has-hover ? #4666d6 : Palette.blue) : root.chosen ? Palette.soft : touch.has-hover ? Palette.soft : root.subtle ? Palette.page : Palette.surface;
    forward-focus: key-focus;
    border-color: root.keyboard-key ? #101724e6 : key-focus.has-focus || root.chosen ? Palette.blue : Palette.line;
    border-width: (root.primary || root.subtle) && !key-focus.has-focus && !root.chosen ? 0px : 1px;
    if root.has-icon:Image{source:root.icon; x:12px;y:(parent.height - self.height)/2;width:16px;height:16px;colorize:root.disabled ? Palette.muted : root.primary ? white : root.chosen ? Palette.blue : Palette.ink;}
    if root.keyboard-key:Rectangle{x:1px;y:1px;width:parent.width - 2px;height:parent.height - 2px;border-radius:5px;border-width:1px;border-color:root.chosen ? #a8ccff : #ffffffb8;background:transparent;}
    // Four offset glyphs work with both the software and GPU renderers. They keep
    // an opaque dark outline even over a white document or a detailed image.
    if root.keyboard-key:Rectangle{
        for offset in [{x:-1,y:0},{x:1,y:0},{x:0,y:-1},{x:0,y:1}]:Text{
            x:offset.x*1px;y:offset.y*1px;width:parent.width;height:parent.height;
            text:root.text;color:#101724;font-size:root.font-size;font-weight:600;
            horizontal-alignment:center;vertical-alignment:center;
        }
    }
    label := Text {x:root.has-icon ? 28px : 0px;width:parent.width - self.x;text:root.text;overflow:root.elide-text ? elide : clip;color:root.keyboard-key ? (root.disabled ? #c4cad4 : white) : root.disabled ? Palette.muted : root.primary ? white : Palette.ink;horizontal-alignment:center;vertical-alignment:center;font-size:root.font-size;font-weight:root.keyboard-key ? 600 : 400;}
    // Slint 1.18.1 ignores FocusOut on disabled FocusScope items. Keep delivery
    // enabled and gate focus entry/actions so a former focus marker can clear.
    key-focus := FocusScope {focus-on-click:root.available;focus-on-tab-navigation:root.available;key-pressed(event)=>{if(root.available && (event.text==Key.Return || event.text==" ")){if(!event.repeat){root.invoke-action();}return accept;}return reject;}}
    touch := TouchArea {
        enabled:root.available;mouse-cursor:pointer;
        pointer-event(event)=>{
            if(event.kind==PointerEventKind.down && event.button==PointerEventButton.left){root.pressed-action=root.action-id;root.pressed-argument=root.argument;root.pressed-text=root.text;root.press-valid=true;root.dragging=false;root.drag-dx=0;root.drag-dy=0;}
            else if(event.kind==PointerEventKind.move && root.draggable && self.pressed){
                let total-dx=root.drag-dx + (self.mouse-x - self.pressed-x)/1px;
                let total-dy=root.drag-dy + (self.mouse-y - self.pressed-y)/1px;
                if(!root.dragging && (abs(total-dx)>5 || abs(total-dy)>5)){
                    root.dragging=true;root.press-valid=false;
                }
                if(root.dragging){
                    let max-x=max(4.0,root.viewport-width - (root.width/1px) - 4.0);
                    let max-y=max(4.0,root.viewport-height - (root.height/1px) - 4.0);
                    let nx=max(4.0,min(max-x,root.base-x + total-dx));
                    let ny=max(4.0,min(max-y,root.base-y + total-dy));
                    root.drag-dx=nx - root.base-x;
                    root.drag-dy=ny - root.base-y;
                }
            }
            else if(event.kind==PointerEventKind.up && root.dragging){
                let final-x=root.base-x + root.drag-dx;
                let final-y=root.base-y + root.drag-dy;
                let span-x=max(1.0,root.viewport-width - (root.width/1px) - 8.0);
                let span-y=max(1.0,root.viewport-height - (root.height/1px) - 8.0);
                let rx=max(0.0,min(1.0,(final-x - 4.0)/span-x));
                let ry=max(0.0,min(1.0,(final-y - 4.0)/span-y));
                root.dragging=false;root.drag-dx=0;root.drag-dy=0;root.press-valid=false;
                Commands.trigger("stream.overlay.move",root.drag-id+"|"+rx+"|"+ry);
            }
            else if(event.kind==PointerEventKind.cancel){root.dragging=false;root.drag-dx=0;root.drag-dy=0;root.press-valid=false;}
        }
        clicked=>{key-focus.focus();if(root.press-valid && !root.dragging && root.pressed-action==root.action-id && root.pressed-argument==root.argument && root.pressed-text==root.text){root.invoke-action();}root.press-valid=false;}
    }
    accessible-role: button;
    accessible-enabled:root.available;
    accessible-label: root.text;
    accessible-id:"action|"+root.action-id+"|"+root.argument+"|"+root.accessible-label;
    accessible-action-default=>{root.invoke-action();}
    UiProbe{control-id:"action|"+root.action-id+"|"+root.argument+"|"+root.accessible-label;kind:"button";label:root.accessible-label;control-enabled:root.available;focused:root.focused;remember-focus:root.remember-focus && root.action-id!="navigation.resolve" && root.action-id!="sync.clear.resolve" && root.action-id!="navigation.back" && root.action-id!="device.select" && root.action-id!="device.settings.open";control-width:root.width;control-height:root.height;focus-requested=>{key-focus.focus();}activate-requested=>{root.invoke-action();}}
}
component TabButton inherits ActionButton { border-width:root.focused ? 1px : 0px; }
component BackButton inherits ActionButton { remember-focus:false;has-icon:true;icon:@image-url("icons/chevron-left.svg"); }
component SettingsCard inherits Rectangle {
    background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;vertical-stretch:0;
    VerticalLayout {padding:20px;spacing:16px;@children}
}
component ThemePreview inherits Rectangle {
    in property <bool> dark-preview;
    in property <bool> chosen;
    height:252px;min-width:190px;horizontal-stretch:1;
    background:Palette.surface;border-radius:12px;border-width:1px;border-color:root.chosen ? Palette.blue : Palette.line;
    VerticalLayout {padding:14px;spacing:12px;
        Rectangle {height:120px;background:root.dark-preview ? #151b29 : #f6f7fa;border-radius:8px;
            Rectangle {x:6px;y:6px;width:parent.width*0.24;height:parent.height - 12px;background:root.dark-preview ? #242d3e : white;border-radius:5px;
                Rectangle {x:6px;y:12px;width:parent.width - 12px;height:6px;background:#6f8af1;border-radius:3px;}
            }
            for i in 3: Rectangle {x:parent.width*0.31;y:18px+i*28px;width:parent.width*0.62;height:15px;background:root.dark-preview ? #303c53 : #e3e8f2;border-radius:4px;}
        }
        Text{text:root.dark-preview ? "深色" : "浅色";font-size:15px;font-weight:600;color:Palette.ink;}
        if root.chosen: Text{text:"已选择";height:38px;color:Palette.blue;vertical-alignment:center;horizontal-alignment:center;font-size:13px;}
        if !root.chosen: ActionButton{text:root.dark-preview ? "切换为深色" : "切换为浅色";action-id:"appearance.toggle";horizontal-stretch:1;}
    }
}
component NavigationItem inherits Rectangle {
    property <bool> available:!root.disabled && !ModalContext.active;
    function invoke-navigation(){if(root.available){nav-focus.focus();Commands.trigger(root.action-id,"");}}
    in property <string> text;
    in property <image> icon;
    in property <string> action-id;
    in property <bool> chosen;
    in property <bool> compact;
    in property <bool> disabled;
    opacity:root.disabled ? 0.45 : 1;
    height:42px;border-radius:7px;
    forward-focus:nav-focus;
    border-color:Palette.blue;border-width:root.available && nav-focus.has-focus ? 1px : 0px;
    background:root.chosen ? Palette.soft : touch.has-hover ? Palette.page : transparent;
    HorizontalLayout {
        padding-left:12px;padding-right:12px;spacing:12px;
        Rectangle {width:20px;
            Image {source:root.icon;width:20px;height:20px;y:(parent.height - self.height)/2;}
        }
        if !root.compact: Text {text:root.text;color:root.chosen ? Palette.blue : Palette.ink;font-weight:root.chosen ? 600 : 400;vertical-alignment:center;font-size:13px;}
        if !root.compact: Rectangle {horizontal-stretch:1;}
    }
    nav-focus:=FocusScope{focus-on-click:root.available;focus-on-tab-navigation:root.available;key-pressed(event)=>{if(root.available && (event.text==Key.Return || event.text==" ")){if(!event.repeat){root.invoke-navigation();}return accept;}return reject;}}
    touch:=TouchArea {enabled:root.available;mouse-cursor:pointer;clicked=>{root.invoke-navigation();}}
    accessible-role:button;accessible-label:root.text;accessible-enabled:root.available;
    accessible-id:"nav|"+root.action-id;
    accessible-action-default=>{root.invoke-navigation();}
    UiProbe{control-id:"nav|"+root.action-id;kind:"navigation";label:root.text;control-enabled:root.available;focused:nav-focus.has-focus;remember-focus:false;control-width:root.width;control-height:root.height;focus-requested=>{nav-focus.focus();}activate-requested=>{root.invoke-navigation();}}
}
export global ReorderDrag {
    in-out property <bool> active;
    in-out property <string> scope;
    in-out property <string> source;
    in-out property <string> target;
    in-out property <bool> after;
    in-out property <length> pointer-y;
    in-out property <length> pointer-x;
}
component ReorderDrop inherits Rectangle {
    in property <string> order-scope;
    in property <string> item-id;
    in property <bool> accept-drop:true;
    private property <length> watched-y:ReorderDrag.pointer-y;
    changed watched-y=>{
        if(ReorderDrag.active && ReorderDrag.scope==root.order-scope && root.accept-drop && ReorderDrag.pointer-x>=root.absolute-position.x && ReorderDrag.pointer-x<root.absolute-position.x+root.width && ReorderDrag.pointer-y>=root.absolute-position.y && ReorderDrag.pointer-y<root.absolute-position.y+root.height){
            ReorderDrag.target=root.item-id;ReorderDrag.after=ReorderDrag.pointer-y>root.absolute-position.y+root.height/2;
        }
    }
    @children
    if ReorderDrag.active && ReorderDrag.scope==root.order-scope && ReorderDrag.target==root.item-id && ReorderDrag.source!=root.item-id:Rectangle{height:3px;y:ReorderDrag.after ? parent.height - 3px : 0px;background:Palette.blue;}
}
component DragHandle inherits Rectangle {
    in property <string> item-id;
    in property <string> label;
    in property <string> order-scope;
    in property <string> action-id;
    in property <string> context;
    in property <bool> disabled;
    private property <string> pressed-context;
    private property <length> start-y;
    private property <bool> moved-far;
    private property <bool> available:!root.disabled && !ModalContext.active;
    changed context=>{ReorderDrag.active=false;}
    changed item-id=>{ReorderDrag.active=false;}
    changed available=>{if(!root.available){ReorderDrag.active=false;}}
    background:handle-touch.has-hover ? Palette.soft : transparent;border-radius:5px;
    border-width:handle-keys.has-focus ? 1px : 0px;border-color:Palette.blue;
    Image{source:@image-url("icons/grip.svg");width:16px;height:20px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;colorize:root.available ? Palette.muted : Palette.line;}
    handle-keys:=FocusScope{focus-on-click:root.available;focus-on-tab-navigation:root.available;key-pressed(event)=>{
        if(root.available && event.modifiers.alt && (event.text==Key.UpArrow || event.text==Key.DownArrow)){if(!event.repeat){Commands.trigger(root.action-id,root.item-id+"|"+(event.text==Key.UpArrow?"up":"down"));}return accept;}
        return reject;
    }}
    handle-touch:=TouchArea{enabled:root.available;mouse-cursor:move;
        pointer-event(event)=>{
            if(event.kind==PointerEventKind.down && event.button==PointerEventButton.left){handle-keys.focus();root.pressed-context=root.context;root.start-y=self.mouse-y;root.moved-far=false;ReorderDrag.scope=root.order-scope;ReorderDrag.source=root.item-id;ReorderDrag.target="";ReorderDrag.active=true;ReorderDrag.pointer-x=root.absolute-position.x+self.mouse-x;ReorderDrag.pointer-y=root.absolute-position.y+self.mouse-y;}
            else if(event.kind==PointerEventKind.up && event.button==PointerEventButton.left){
                if(ReorderDrag.active && root.moved-far && root.pressed-context==root.context && ReorderDrag.target!="" && ReorderDrag.target!=root.item-id){Commands.trigger(root.action-id,root.item-id+"|"+ReorderDrag.target+"|"+(ReorderDrag.after?"after":"before"));}
                ReorderDrag.active=false;
            }else if(event.kind==PointerEventKind.cancel){ReorderDrag.active=false;}
        }
        moved=>{if(self.pressed && ReorderDrag.active){root.moved-far=abs(self.mouse-y - root.start-y)>6px;ReorderDrag.target="";ReorderDrag.pointer-x=root.absolute-position.x+self.mouse-x;ReorderDrag.pointer-y=root.absolute-position.y+self.mouse-y;}}
    }
    accessible-role:groupbox;accessible-label:root.label;accessible-enabled:root.available;accessible-id:"reorder|"+root.order-scope+"|"+root.item-id;
    UiProbe{control-id:"reorder|"+root.order-scope+"|"+root.item-id;kind:"drag-handle";label:root.label;control-enabled:root.available;remember-focus:false;focused:handle-keys.has-focus;control-width:root.width;control-height:root.height;focus-requested=>{handle-keys.focus();}}
}
component DeviceListPane inherits Rectangle {
    in property <bool> compact;
    in property <bool> refreshing;
    in property <string> refresh-error;
    in property <[DeviceRow]> devices;
    in property <string> selected-uuid;
    in-out property <string> device-query;
    in property <int> device-total;
    in property <int> device-online;
    in property <string> selection-action:"device.select";
    in property <bool> locked;
    in property <bool> settings-open;
    in property <string> app-version;
    in property <bool> isolated-preview;
width:root.compact ? 224px : 276px;background:Palette.surface;
                    Rectangle {x:parent.width - 1px;width:1px;background:Palette.line;}
                    VerticalLayout {padding:16px;spacing:16px;
                        HorizontalLayout {height:44px;spacing:10px;Image{source:@image-url("../../../shared/icons/rhremote.svg");width:30px;height:30px;}Text{text:"RHRemote";color:Palette.ink;font-size:19px;font-weight:600;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}}
                        HorizontalLayout {spacing:8px;height:36px;
                            Text {text:"远程设备";font-size:19px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                            Rectangle {horizontal-stretch:1;}
                            ActionButton {text:root.refreshing ? "…" : "刷新";accessible-label:root.refreshing ? "刷新中…" : "刷新";remember-focus:false;action-id:"devices.refresh";disabled:root.refreshing || root.locked;height:32px;}
                            ActionButton{text:"+";accessible-label:"添加电脑";remember-focus:false;action-id:"device.add.open";disabled:root.locked;width:32px;height:32px;}
                        }
                        LineEdit {text <=> root.device-query;accessible-label:"搜索名称或地址";placeholder-text:"搜索名称或地址";height:36px;edited(value)=>{Commands.trigger("devices.filter",value);}}
                        if root.refresh-error!="":Text{text:root.refresh-error;accessible-label:root.refresh-error;color:Palette.failure;font-size:12px;wrap:word-wrap;max-height:48px;overflow:elide;}
                        ScrollView {test-id:"scroll|devices";horizontal-stretch:1;vertical-stretch:1;content-width:self.width;
                            VerticalLayout {spacing:6px;alignment:start;
                                for device in root.devices: ReorderDrop {
                                    order-scope:"devices";item-id:device.uuid;
                                    property <bool> available:!ModalContext.active && !root.locked;
                                    height:86px;border-radius:8px;
                                    forward-focus:device-focus;
                                    border-width:device-focus.has-focus ? 1px : 0px;border-color:Palette.blue;
                                    background:device.uuid==root.selected-uuid ? Palette.soft : device-touch.has-hover ? Palette.page : transparent;
                                    if device.uuid==root.selected-uuid: Rectangle {x:0px;y:18px;width:3px;height:50px;border-radius:2px;background:Palette.blue;}
                                    HorizontalLayout {padding:12px;padding-left:36px;spacing:8px;
                                        Rectangle {width:30px;height:34px;border-radius:8px;background:Palette.page;vertical-stretch:0;
                                            Image {source:@image-url("icons/monitor.svg");width:21px;height:21px;x:6px;y:6px;}
                                        }
                                        VerticalLayout {spacing:5px;alignment:center;
                                            Text {text:device.name;color:Palette.ink;font-size:14px;font-weight:device.uuid==root.selected-uuid ? 600 : 400;overflow:elide;}
                                            Text {text:device.address;color:Palette.muted;font-size:11px;overflow:elide;}
                                            HorizontalLayout {spacing:5px;
                                                Rectangle {width:6px;height:6px;border-radius:3px;background:device.is-self ? Palette.blue : device.online ? Palette.success : #98a1b2;vertical-stretch:0;}
                                                device-row-status:=Text {text:device.status;color:device.is-self ? Palette.blue : device.check-failed ? Palette.failure : !device.pending && device.paired && device.online ? Palette.success : Palette.muted;font-size:10px;overflow:elide;}
                                            }
                                        }
                                    }
                                    device-focus:=FocusScope{focus-on-click:parent.available;focus-on-tab-navigation:parent.available;key-pressed(event)=>{if(parent.available && (event.text==Key.Return || event.text==" ")){if(!event.repeat){Commands.trigger(root.selection-action,device.uuid);}return accept;}return reject;}}
                                    UiProbe{control-id:"device|"+device.uuid;kind:"device";label:"选择设备 "+device.name;control-enabled:parent.available;remember-focus:false;focused:device-focus.has-focus;control-width:parent.width;control-height:parent.height;focus-requested=>{device-focus.focus();}}
                                    device-touch:=TouchArea {enabled:parent.available;mouse-cursor:pointer;clicked=>{device-focus.focus();Commands.trigger(root.selection-action,device.uuid);}}
                                    DragHandle{x:5px;y:24px;width:26px;height:38px;item-id:device.uuid;label:"拖动设备 "+device.name+" 排序";order-scope:"devices";action-id:"device.move";context:root.selection-action+"|"+root.device-query;disabled:!parent.available;}
                                    accessible-role:button;accessible-label:"选择设备 "+device.name;
                                    accessible-enabled:self.available;
                                    accessible-id:"device|"+device.uuid;
                                    accessible-action-default=>{if(self.available){Commands.trigger(root.selection-action,device.uuid);}}
                                }
                                if root.devices.length==0: VerticalLayout {padding-top:24px;spacing:16px;
                                    Text {text:root.device-total>0 ? "没有匹配的设备" : "尚未添加设备";color:Palette.muted;font-size:12px;horizontal-alignment:center;wrap:word-wrap;}
                                    if root.device-total>0 && root.device-query!="":HorizontalLayout {Rectangle{horizontal-stretch:1;}ActionButton {text:"清除搜索";action-id:"devices.filter.clear";argument:root.device-query;}Rectangle{horizontal-stretch:1;}}
                                }
                            }
                        }
                        Rectangle {height:1px;background:Palette.line;}
                        Text {text:root.device-total+" 台设备  ·  "+root.device-online+" 台在线";font-size:11px;color:Palette.muted;}
                        NavigationItem{text:"设置";icon:@image-url("icons/settings.svg");action-id:"app.settings.open";chosen:root.settings-open;disabled:root.locked;}
                        if root.isolated-preview:Text{text:"测试预览 · 独立配置";color:Palette.blue;font-size:11px;}
                        Text{text:"v"+root.app-version+" · Moonlight · GPL v3";color:Palette.muted;font-size:10px;}
                    }

}
component DetailField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color:Palette.ink;
    spacing:8px;
    Text {text:root.label;color:Palette.muted;font-size:12px;}
    Text {text:root.value;color:root.value-color;font-size:14px;overflow:elide;}
}
component DeviceContextHeader inherits Rectangle {
    in property <DeviceRow> device;
    in property <string> name;
    in property <string> address;
    in property <string> uuid;
    in property <length> content-inset:24px;
    in property <bool> settings-open;
    height:144px;background:Palette.surface;
    VerticalLayout {spacing:0px;
        context-info:=Rectangle {height:88px;background:Palette.page;
            VerticalLayout {padding:16px;padding-left:root.content-inset;padding-right:root.content-inset;spacing:8px;
                device-title-row:=HorizontalLayout {height:32px;spacing:10px;
                    Text{text:root.name;font-size:24px;font-weight:600;color:Palette.ink;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;vertical-alignment:center;}
                    VerticalLayout {width:100px;spacing:0px;
                        Rectangle{vertical-stretch:1;}
                        device-state:=Rectangle {width:100px;height:26px;border-radius:13px;background:Palette.surface;
                            device-status-label:=Text{text:root.device.status;color:root.device.is-self ? Palette.blue : root.device.check-failed ? Palette.failure : root.device.pending ? Palette.muted : root.device.paired && root.device.online ? Palette.success : Palette.muted;font-size:11px;horizontal-alignment:center;vertical-alignment:center;}
                        }
                        Rectangle{vertical-stretch:1;}
                    }
                }
                Text{text:root.device.name==root.device.host-name ? root.address : root.device.host-name;height:16px;color:Palette.muted;font-size:12px;overflow:elide;vertical-alignment:center;}
            }
        }
        context-tabs:=Rectangle {height:56px;
            HorizontalLayout {padding-top:9px;padding-bottom:9px;padding-left:root.content-inset;padding-right:root.content-inset;spacing:8px;
                TabButton{text:"概览";action-id:"device.select";argument:root.uuid;chosen:!root.settings-open;}
                TabButton{text:"连接设置";action-id:"device.settings.open";argument:root.uuid;chosen:root.settings-open;}
                Rectangle{horizontal-stretch:1;}
            }
            Rectangle{y:parent.height - 1px;height:1px;background:Palette.line;}
        }
    }
}
export component FloatingKeyboardWindow inherits Window {
    title:"RHRemote-Moonlight · 悬浮键盘";
    no-frame:true;background:transparent;
    preferred-width:1px;preferred-height:1px;min-width:1px;min-height:1px;
    max-width:32768px;max-height:32768px;
    in property <[KeyboardKey]> keys;
    in property <bool> busy;
    for key in root.keys:ActionButton{
        x:(key.x + self.drag-dx)*1px;y:(key.y + self.drag-dy)*1px;width:key.width*1px;height:key.height*1px;min-width:1px;
        text:key.id=="backspace" ? "Backspace" : key.label;accessible-label:key.description;action-id:key.action;argument:key.argument;chosen:key.chosen;
        draggable:key.draggable;drag-id:key.id;base-x:key.x;base-y:key.y;viewport-width:root.width/1px;viewport-height:root.height/1px;
        disabled:root.busy;keyboard-key:true;border-radius:6px;remember-focus:false;font-size:key.width<32 ? 10px : 12px;
    }
}

export component StreamToolbar inherits Window {
    in property <bool> keyboard-button-visible:true;
    in property <bool> simple-keyboard;
    in property <bool> floating-keyboard;
    in property <string> floating-keyboard-error;
    private property <bool> themed-dark:Palette.dark;
    init=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    changed themed-dark=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    title:"RHRemote-Moonlight · 串流控制";no-frame:true;
    background:transparent;default-font-family:"Microsoft YaHei UI";default-font-size:12px;
    in property <bool> expanded:true;
    in property <bool> pending;
    in property <bool> canceling;
    in property <bool> connection-failed;
    in property <string> connection-error;
    changed connection-failed=>{toolbar-focus.focus();}
    in property <string> pending-cancel-label:"取消连接";
    in property <bool> audio-enabled;
    in-out property <int> audio-volume:100;
    in property <bool> stats-enabled;
    in property <bool> busy;
    in property <bool> failed;
    in property <string> controls-tab:"input";
    in property <string> device-name;
    in property <string> status;
    in property <[RemoteDisplay]> displays;
    in property <[string]> display-labels;
    in property <[string]> shortcut-labels;
    in property <[string]> shortcut-ids;
    in-out property <int> display-index:0;
    property <bool> narrow:self.width<400px;
    preferred-width:expanded || pending || connection-failed ? 560px : 72px;
    preferred-height:connection-failed ? 248px : expanded ? 292px : pending ? (narrow ? 160px : 116px) : 28px;
    min-width:1px;min-height:1px;
    max-width:expanded || pending || connection-failed ? 560px : 72px;max-height:connection-failed ? 248px : expanded ? 292px : pending ? (narrow ? 160px : 116px) : 28px;
    forward-focus:toolbar-focus;
    toolbar-focus:=FocusScope{
        focus-on-click:false;focus-on-tab-navigation:false;
        init=>{self.focus();}
        property <bool> body-visible:root.expanded || root.pending || root.connection-failed;
        changed body-visible=>{self.focus();}
        key-pressed(event)=>{
            if(event.text==Key.Escape){
                if(!event.repeat){
                    if(root.connection-failed){Commands.trigger("connection.dismiss","");}
                    else if(root.expanded){Commands.trigger("stream.controls.toggle","");}
                    else if(root.pending && !root.canceling){Commands.trigger("stream.disconnect","");}
                }
                return accept;
            }
            return reject;
        }
        UiProbe{control-id:"scope|toolbar";kind:"scope";focused:toolbar-focus.has-focus;remember-focus:false;focus-requested=>{toolbar-focus.focus();}}
    // The same handle remains at the center of the native stream's top edge.
    ActionButton {
        x:(parent.width - self.width)/2;y:0px;width:72px;height:28px;min-width:1px;border-radius:10px;
        primary:true;has-icon:!root.connection-failed;icon:root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
        text:root.connection-failed ? "关闭" : root.expanded ? "收起" : "控制";action-id:root.connection-failed ? "navigation.back" : "stream.controls.toggle";
    }
    if !root.expanded && !root.connection-failed && root.floating-keyboard-error!="":Rectangle{
        x:(parent.width - 72px)/2+60px;y:3px;width:8px;height:8px;border-radius:4px;
        background:Palette.failure;border-width:1px;border-color:#fff;
        accessible-role:text;accessible-label:"悬浮键盘未显示";
    }
    if root.connection-failed:Rectangle{
        y:28px;height:parent.height - 28px;
        background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;
        VerticalLayout{padding:16px;spacing:12px;
            HorizontalLayout{spacing:12px;
                Text{text:"连接失败";color:Palette.ink;font-size:15px;font-weight:600;}
                Text{text:root.device-name;color:Palette.muted;horizontal-alignment:right;overflow:elide;min-width:0px;horizontal-stretch:1;}
            }
            SessionErrorDetails{test-id:"scroll|connection-error";label:"连接错误详情";message:root.connection-error;message-font-size:12px;}
            HorizontalLayout{spacing:8px;alignment:end;
                ActionButton{text:"返回设备";action-id:"connection.dismiss";}
                ActionButton{text:"重试";primary:true;action-id:"connection.retry";}
            }
        }
    }
    if root.pending && !root.expanded && !root.connection-failed:Rectangle{
        y:28px;height:parent.height - 28px;
        background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;
        VerticalLayout{padding:12px;spacing:8px;
            Text{text:root.device-name;color:Palette.ink;font-size:13px;overflow:elide;}
            if !root.narrow:HorizontalLayout{spacing:12px;
                Text{text:root.status;color:Palette.muted;vertical-alignment:center;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;accessible-label:root.status;}
                ActionButton{text:root.pending-cancel-label;action-id:"stream.disconnect";disabled:root.canceling;}
            }
            if root.narrow:VerticalLayout{spacing:8px;
                Text{text:root.status;color:Palette.muted;wrap:word-wrap;vertical-stretch:1;accessible-label:root.status;}
                ActionButton{text:root.pending-cancel-label;action-id:"stream.disconnect";disabled:root.canceling;}
            }
        }
    }
    if root.expanded && !root.connection-failed: Rectangle {
        y:28px;height:parent.height - 28px;
        background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;clip:true;
        Rectangle {x:0px;y:0px;width:parent.width;height:3px;background:@linear-gradient(90deg, Palette.blue 0%, Palette.purple 100%);}
        VerticalLayout {
            padding:12px;spacing:8px;
            HorizontalLayout {spacing:8px;
                Rectangle {width:7px;height:7px;border-radius:3.5px;background:root.failed ? Palette.failure : Palette.success;y:(parent.height - self.height)/2;}
                Text{text:root.device-name;color:Palette.ink;font-size:13px;font-weight:600;vertical-alignment:center;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
                ActionButton{text:root.floating-keyboard-error!="" ? "关闭悬浮键盘" : root.floating-keyboard ? "悬浮键盘：开" : "悬浮键盘：关";action-id:"stream.keyboard.floating.set";argument:root.floating-keyboard ? "false" : "true";chosen:root.floating-keyboard && root.floating-keyboard-error=="";disabled:root.busy || root.pending;}
                ActionButton{text:root.pending ? root.pending-cancel-label : "断开";action-id:"stream.disconnect";disabled:root.canceling;}
            }
            HorizontalLayout {spacing:6px;
                TabButton{text:"操作";action-id:"stream.controls.tab";argument:"input";chosen:root.controls-tab=="input";horizontal-stretch:1;}
                TabButton{text:"屏幕";action-id:"stream.controls.tab";argument:"displays";chosen:root.controls-tab=="displays";horizontal-stretch:1;}
                TabButton{text:"声音";action-id:"stream.controls.tab";argument:"audio";chosen:root.controls-tab=="audio";horizontal-stretch:1;}
            }
            ScrollView {test-id:"scroll|toolbar";vertical-stretch:1;
                VerticalLayout {spacing:8px;alignment:start;padding-right:12px;
                    if root.controls-tab=="input":VerticalLayout{spacing:8px;
                        if root.floating-keyboard-error!="":Text{text:root.floating-keyboard-error;color:Palette.failure;wrap:word-wrap;accessible-label:root.floating-keyboard-error;}
                        if root.floating-keyboard-error!="":HorizontalLayout{spacing:8px;
                            Rectangle{horizontal-stretch:1;}
                            ActionButton{text:"重试";action-id:"stream.keyboard.floating.set";argument:"true";disabled:root.busy || root.pending;}
                        }
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"Ctrl+Alt+Delete";subtle:true;has-icon:true;icon:@image-url("icons/lock.svg");action-id:"stream.shortcut";argument:"ctrl-alt-delete";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"shortcuts";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"外置快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"pinned-shortcuts";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"重置位置";subtle:true;action-id:"stream.overlay.reset";disabled:root.busy;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"Ctrl+Alt+Delete";subtle:true;has-icon:true;icon:@image-url("icons/lock.svg");action-id:"stream.shortcut";argument:"ctrl-alt-delete";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"shortcuts";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"外置快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"pinned-shortcuts";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"重置位置";subtle:true;action-id:"stream.overlay.reset";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:root.simple-keyboard ? "键盘布局：简化" : "键盘布局：完整";action-id:"stream.keyboard.layout.set";argument:root.simple-keyboard ? "full" : "simple";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:root.keyboard-button-visible ? "显示键盘浮钮：开" : "显示键盘浮钮：关";action-id:"stream.keyboard.button.set";argument:root.keyboard-button-visible ? "false" : "true";chosen:root.keyboard-button-visible;horizontal-stretch:1;}
                            ActionButton{text:root.stats-enabled ? "统计：开" : "统计：关";action-id:"stream.stats.toggle";chosen:root.stats-enabled;disabled:root.busy;has-icon:true;icon:@image-url("icons/chart.svg");}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            HorizontalLayout{Rectangle{horizontal-stretch:1;}ActionButton{text:root.stats-enabled ? "统计：开" : "统计：关";action-id:"stream.stats.toggle";chosen:root.stats-enabled;disabled:root.busy;has-icon:true;icon:@image-url("icons/chart.svg");}}
                            ActionButton{text:root.simple-keyboard ? "键盘布局：简化" : "键盘布局：完整";action-id:"stream.keyboard.layout.set";argument:root.simple-keyboard ? "full" : "simple";disabled:root.busy;}
                            ActionButton{text:root.keyboard-button-visible ? "显示键盘浮钮：开" : "显示键盘浮钮：关";action-id:"stream.keyboard.button.set";argument:root.keyboard-button-visible ? "false" : "true";chosen:root.keyboard-button-visible;}
                        }
                    }
                    if root.controls-tab=="displays":VerticalLayout{spacing:8px;
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"自动选屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"auto";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"虚拟屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"virtual";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"自动选屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"auto";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"虚拟屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"virtual";disabled:root.busy;horizontal-stretch:1;}
                        }
                        HorizontalLayout{spacing:8px;
                            ActionButton{text:"显示器 ▾";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.menu.open";argument:"displays";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"刷新";action-id:"stream.displays.refresh";disabled:root.busy;}
                        }
                        Text{text:root.display-labels.length>root.display-index && root.display-index>=0 ? root.display-labels[root.display-index] : "暂无屏幕信息";color:Palette.muted;font-size:12px;overflow:elide;}
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"窗口移到左屏";subtle:true;has-icon:true;icon:@image-url("icons/move-left.svg");action-id:"stream.window.move";argument:"left";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"窗口移到右屏";subtle:true;has-icon:true;icon:@image-url("icons/move-right.svg");action-id:"stream.window.move";argument:"right";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"窗口移到左屏";subtle:true;has-icon:true;icon:@image-url("icons/move-left.svg");action-id:"stream.window.move";argument:"left";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"窗口移到右屏";subtle:true;has-icon:true;icon:@image-url("icons/move-right.svg");action-id:"stream.window.move";argument:"right";disabled:root.busy;horizontal-stretch:1;}
                        }
                    }
                    if root.controls-tab=="audio":VerticalLayout{spacing:8px;
                        ActionButton{text:root.audio-enabled ? "声音：开" : "声音：关";action-id:"stream.audio.toggle";chosen:root.audio-enabled;disabled:root.busy;}
                        HorizontalLayout{spacing:8px;
                            Text{text:"音量";color:Palette.ink;vertical-alignment:center;}
                            SpinBox{minimum:0;maximum:100;value <=> root.audio-volume;enabled:!root.busy;max-width:120px;accessible-label:"串流音量";edited(v)=>{Commands.trigger("stream.audio.volume",v);}}
                            Text{text:"%";color:Palette.muted;vertical-alignment:center;}
                        }
                    }
                }
            }
            HorizontalLayout{spacing:8px;
                Text{text:root.status;color:root.failed ? Palette.failure : Palette.muted;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;vertical-alignment:center;accessible-label:root.status;}
                if root.failed:ActionButton{text:"详情";action-id:"stream.menu.open";argument:"feedback";height:30px;}
            }
        }
    }
    }
}
export component StreamPicker inherits Window {
    private property <bool> themed-dark:Palette.dark;
    init=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    changed themed-dark=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    title:"RHRemote-Moonlight · 选择";no-frame:true;
    background:Palette.surface;default-font-family:"Microsoft YaHei UI";default-font-size:13px;
    in property <string> kind;
    in property <[string]> labels;
    in property <[string]> values;
    in property <[bool]> enabled-items;
    in property <[bool]> chosen-items;
    in property <bool> busy;
    in property <string> error;
    preferred-width:420px;preferred-height:400px;min-width:1px;min-height:1px;
    callback dismiss();
    forward-focus:focus;
    focus:=FocusScope{
        focus-on-click:false;focus-on-tab-navigation:false;
        init=>{self.focus();}
        property <string> active-kind:root.kind;
        changed active-kind=>{if(root.kind!=""){self.focus();}}
        key-pressed(event)=>{if(event.text==Key.Escape){root.dismiss();return accept;}return reject;}
        UiProbe{control-id:"scope|picker";kind:"scope";focused:focus.has-focus;remember-focus:false;focus-requested=>{focus.focus();}}
        VerticalLayout{padding:8px;spacing:6px;
            HorizontalLayout{
                Text{text:root.kind=="shortcuts" ? "快捷键" : root.kind=="pinned-shortcuts" ? "外置快捷键（点击勾选）" : root.kind=="feedback" ? "操作失败" : "屏幕";color:Palette.ink;vertical-alignment:center;}
                Rectangle{horizontal-stretch:1;}
                if root.kind!="feedback" && root.error!="":ActionButton{text:"详情";action-id:"stream.menu.open";argument:"feedback";}
                ActionButton{text:"关闭";action-id:"stream.menu.close";}
            }
            if root.kind=="feedback":SessionErrorDetails{test-id:"scroll|picker";label:"会话操作错误详情";message:root.error;}
            if root.kind!="feedback":ScrollView{test-id:"scroll|picker";vertical-stretch:1;horizontal-stretch:1;
                VerticalLayout{spacing:4px;alignment:start;
                    if root.error!="":Text{text:root.error;color:Palette.failure;wrap:word-wrap;}
                    if root.kind!="feedback" && root.labels.length==0:Text{text:"暂无屏幕信息，请在屏幕分类刷新。";color:Palette.muted;wrap:word-wrap;}
                    if root.kind!="feedback":VerticalLayout{spacing:4px;
                        for item-label[index] in root.labels:Rectangle{
                            property <bool> available:!root.busy && (root.enabled-items.length<=index || root.enabled-items[index]);
                            property <bool> chosen:root.chosen-items.length>index && root.chosen-items[index];
                            property <string> menu:root.kind;
                            property <string> value:root.values[index];
                            property <string> row-action:root.kind=="shortcuts" ? "stream.shortcut" : root.kind=="pinned-shortcuts" ? "stream.shortcut.pin.set" : "stream.display.select";
                            property <bool> press-valid:false;
                            property <string> pressed-menu;
                            property <string> pressed-value;
                            changed menu=>{self.press-valid=false;}
                            changed value=>{self.press-valid=false;}
                            changed available=>{if(!self.available){self.press-valid=false;}}
                            height:40px;border-radius:8px;background:self.chosen || touch.has-hover ? Palette.soft : transparent;
                            forward-focus:row-focus;
                            border-width:row-focus.has-focus ? 1px : 0px;border-color:Palette.blue;
                            Text{x:10px;width:parent.width - 20px;text:parent.chosen && root.kind=="pinned-shortcuts" ? item-label+"  ✓" : item-label;color:parent.available ? Palette.ink : Palette.muted;vertical-alignment:center;overflow:elide;}
                            row-focus:=FocusScope{focus-on-click:parent.available;focus-on-tab-navigation:parent.available;key-pressed(event)=>{if(parent.available && (event.text==Key.Return || event.text==" ")){if(!event.repeat){Commands.trigger(parent.row-action,root.values[index]);}return accept;}return reject;}}
                            touch:=TouchArea{
                                enabled:parent.available;mouse-cursor:pointer;
                                pointer-event(event)=>{
                                    if(event.kind==PointerEventKind.down && event.button==PointerEventButton.left){parent.pressed-menu=parent.menu;parent.pressed-value=parent.value;parent.press-valid=true;}
                                    else if(event.kind==PointerEventKind.cancel){parent.press-valid=false;}
                                }
                                clicked=>{if(parent.press-valid && parent.available && parent.pressed-menu==parent.menu && parent.pressed-value==parent.value){row-focus.focus();Commands.trigger(parent.row-action,parent.value);}parent.press-valid=false;}
                            }
                            accessible-role:button;accessible-enabled:self.available;accessible-label:item-label;
                            accessible-id:"picker|"+root.kind+"|"+root.values[index];
                            accessible-action-default=>{if(self.available){Commands.trigger(self.row-action,root.values[index]);}}
                            UiProbe{control-id:"picker|"+root.kind+"|"+root.values[index];kind:"menu-item";label:item-label;control-enabled:parent.available;focused:row-focus.has-focus;control-width:parent.width;control-height:parent.height;focus-requested=>{row-focus.focus();}}
                        }
                    }
                }
            }
        }
    }
}
export component MainWindow inherits Window {
    in property <string> session-name;
    in property <bool> session-window;
    in property <bool> selected-has-session;
