import { ProgressIndicator, ScrollView as BaseScrollView, LineEdit as BaseLineEdit, CheckBox as BaseCheckBox, SpinBox as BaseSpinBox, ComboBox as BaseComboBox, Palette as WidgetPalette } from "std-widgets.slint";

export global Commands { callback trigger(string,string); }
export global UiTest {
    in property <bool> enabled;
    in property <int> generation;
    in property <string> operation;
    in property <string> target;
    in property <float> scroll-delta;
    callback report(string,string,string,bool,bool,bool,bool,float,float,float,float);
}
export global KeyboardFocus {
    in-out property <string> last-content-control;
    in-out property <string> restore-target;
    in-out property <int> restore-generation;
    public function remember(id:string,focused:bool,content:bool){
        if(focused && content){KeyboardFocus.last-content-control=id;}
    }
}
component UiProbe inherits Rectangle {
    width:0px;height:0px;
    in property <string> control-id;
    in property <string> kind;
    in property <string> label;
    in property <bool> control-enabled:true;
    in property <bool> focused;
    in property <bool> checked;
    in property <bool> expanded;
    in property <bool> remember-focus:true;
    in property <length> control-width;
    in property <length> control-height;
    in property <length> scroll-y;
    in property <length> scroll-maximum;
    in property <int> request:UiTest.generation;
    callback focus-requested();
    callback scroll-requested(float);
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed focused=>{if(root.control-id!=""){KeyboardFocus.remember(root.control-id,root.focused,root.remember-focus);}}
    changed control-id=>{if(root.focused && root.control-id!=""){KeyboardFocus.remember(root.control-id,true,root.remember-focus);}}
    changed restore-request=>{if(root.control-id!="" && KeyboardFocus.restore-target==root.control-id && root.control-enabled){root.focus-requested();}}
    changed request=>{
        if(UiTest.enabled && root.control-id!=""){
            if(UiTest.operation=="inspect"){
                UiTest.report(root.control-id,root.kind,root.label,root.control-enabled,root.focused,root.checked,root.expanded,root.control-width/1px,root.control-height/1px,root.scroll-y/1px,root.scroll-maximum/1px);
            }else if(UiTest.target==root.control-id && root.control-enabled){
                if(UiTest.operation=="focus"){root.focus-requested();}
                else if(UiTest.operation=="scroll" && root.kind=="scroll"){root.scroll-requested(UiTest.scroll-delta);}
            }
        }
    }
}
component LineEdit inherits BaseLineEdit {
    property <string> test-label:root.accessible-label!="" ? root.accessible-label : root.placeholder-text;
    property <string> test-id:"input|"+root.test-label;
    accessible-id:root.test-id;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"input",root.test-label,root.enabled,root.has-focus,false,false,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.enabled){root.focus();}}}
}
component ComboBox inherits BaseComboBox {
    property <string> test-id:"choice|"+root.accessible-label;
    accessible-id:root.test-id;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"combobox",root.accessible-label,root.enabled,root.has-focus,false,root.accessible-expanded,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.enabled){root.focus();}}}
}
component CheckBox inherits BaseCheckBox {
    property <string> test-id:"check|"+root.accessible-label;
    accessible-id:root.test-id;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"checkbox",root.accessible-label,root.enabled,root.has-focus,root.checked,false,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.enabled){root.focus();}}}
}
component SpinBox inherits BaseSpinBox {
    property <string> test-id:"spin|"+root.accessible-label;
    accessible-id:root.test-id;
    property <int> test-request:UiTest.generation;
    property <int> restore-request:KeyboardFocus.restore-generation;
    changed has-focus=>{KeyboardFocus.remember(root.test-id,root.has-focus,true);}
    changed restore-request=>{if(KeyboardFocus.restore-target==root.test-id && root.enabled){root.focus();}}
    changed test-request=>{if(UiTest.enabled){if(UiTest.operation=="inspect"){UiTest.report(root.test-id,"spinbox",root.accessible-label,root.enabled,root.has-focus,false,false,root.width/1px,root.height/1px,0,0);}else if(UiTest.operation=="focus" && UiTest.target==root.test-id && root.enabled){root.focus();}}}
}
component ScrollView inherits BaseScrollView {
    in property <string> test-id;
    UiProbe{control-id:root.test-id;kind:"scroll";control-width:root.width;control-height:root.height;scroll-y:root.content-y;scroll-maximum:max(0px,root.content-height - root.visible-height);scroll-requested(delta)=>{root.content-y=max(-max(0px,root.content-height - root.visible-height),min(0px,root.content-y + delta*1px));}}
}
export struct DeviceRow { uuid:string, name:string, host-name:string, address:string, search-addresses:string, status:string, paired:bool, online:bool, is-self:bool }
export struct ProfileSource { client-id:string, label:string }
export struct CopyField { label:string, value:string }
export struct SyncConflictRow { label:string, local:string, remote:string }
export struct RemoteDisplay { id:string,label:string,chosen:bool,available:bool }
export struct SettingRow { key:string,label:string,kind:string,help:string,flag:bool,number:int,input-text:string,invalid:bool,minimum:int,maximum:int,step:int,selected-index:int,option-labels:[string],option-values:[string] }
export struct RouteRow { key:string,label:string,enabled:bool,can-move-up:bool,can-move-down:bool,can-disable:bool }
export global Palette {
    in property <bool> dark;
    out property <color> page: dark ? #151b29 : #f6f7fa;
    out property <color> surface: dark ? #1b2232 : #ffffff;
    out property <color> ink: dark ? #e1e8f6 : #34415b;
    out property <color> muted: dark ? #a4b1c8 : #69778e;
    out property <color> line: dark ? #303c53 : #e5eaf4;
    out property <color> blue: dark ? #6f8af1 : #5274e8;
    out property <color> soft: dark ? #253452 : #edf2ff;
    out property <color> purple: dark ? #ba9aef : #8b5be2;
    out property <color> failure: dark ? #f28b9c : #b04452;
}
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> action-id;
    in property <string> argument;
    in property <bool> primary:false;
    in property <bool> chosen:false;
    in property <bool> disabled:false;
    in property <bool> subtle:false;
    in property <bool> has-icon:false;
    in property <image> icon;
    out property <bool> focused:key-focus.has-focus;
    callback focused-in();
    changed focused=>{if(root.focused){root.focused-in();}}
    min-width: label.preferred-width + 32px + (root.has-icon ? 24px : 0px);
    preferred-width: label.preferred-width + 32px + (root.has-icon ? 24px : 0px);
    horizontal-stretch:0;
    height: 38px;
    border-radius: 8px;
    background: root.disabled ? Palette.soft : root.primary ? (touch.has-hover ? #4666d6 : Palette.blue) : root.chosen ? Palette.soft : touch.has-hover ? Palette.soft : root.subtle ? Palette.page : Palette.surface;
    forward-focus: key-focus;
    border-color: key-focus.has-focus || root.chosen ? Palette.blue : Palette.line;
    border-width: (root.primary || root.subtle) && !key-focus.has-focus && !root.chosen ? 0px : 1px;
    if root.has-icon:Image{source:root.icon; x:12px;y:(parent.height - self.height)/2;width:16px;height:16px;colorize:root.disabled ? Palette.muted : root.primary ? white : root.chosen ? Palette.blue : Palette.ink;}
    label := Text {x:root.has-icon ? 28px : 0px;width:parent.width - self.x;text:root.text;color:root.disabled ? Palette.muted : root.primary ? white : Palette.ink;horizontal-alignment:center;vertical-alignment:center;font-size:13px;}
    // Slint 1.18.1 ignores FocusOut on disabled FocusScope items. Keep delivery
    // enabled and gate focus entry/actions so a former focus marker can clear.
    key-focus := FocusScope {focus-on-click:!root.disabled;focus-on-tab-navigation:!root.disabled;key-pressed(event)=>{if(!root.disabled && (event.text==Key.Return || event.text==" ")){Commands.trigger(root.action-id,root.argument);return accept;}return reject;}}
    touch := TouchArea {enabled:!root.disabled;mouse-cursor:pointer;clicked=>{key-focus.focus();Commands.trigger(root.action-id,root.argument);}}
    accessible-role: button;
    accessible-enabled:!root.disabled;
    accessible-label: root.text;
    accessible-id:"action|"+root.action-id+"|"+root.argument+"|"+root.accessible-label;
    accessible-action-default=>{if(!root.disabled){Commands.trigger(root.action-id,root.argument);}}
    UiProbe{control-id:"action|"+root.action-id+"|"+root.argument+"|"+root.accessible-label;kind:"button";label:root.accessible-label;control-enabled:!root.disabled;focused:root.focused;remember-focus:root.action-id!="navigation.resolve" && root.action-id!="sync.clear.resolve" && root.action-id!="navigation.back" && root.action-id!="device.select" && root.action-id!="device.settings.open";control-width:root.width;control-height:root.height;focus-requested=>{key-focus.focus();}}
}
component TabButton inherits ActionButton { border-width:root.focused ? 1px : 0px; }
component SettingsCard inherits Rectangle {
    background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;vertical-stretch:0;
    VerticalLayout {padding:20px;spacing:16px;@children}
}
component ThemePreview inherits Rectangle {
    in property <bool> dark-preview;
    in property <bool> chosen;
    height:252px;min-width:190px;horizontal-stretch:1;
    background:Palette.surface;border-radius:12px;border-width:1px;border-color:root.chosen ? Palette.blue : Palette.line;
    VerticalLayout {padding:14px;spacing:12px;
        Rectangle {height:120px;background:root.dark-preview ? #151b29 : #f6f7fa;border-radius:8px;
            Rectangle {x:6px;y:6px;width:parent.width*0.24;height:parent.height - 12px;background:root.dark-preview ? #242d3e : white;border-radius:5px;
                Rectangle {x:6px;y:12px;width:parent.width - 12px;height:6px;background:#6f8af1;border-radius:3px;}
            }
            for i in 3: Rectangle {x:parent.width*0.31;y:18px+i*28px;width:parent.width*0.62;height:15px;background:root.dark-preview ? #303c53 : #e3e8f2;border-radius:4px;}
        }
        Text{text:root.dark-preview ? "深色" : "浅色";font-size:15px;font-weight:600;color:Palette.ink;}
        if root.chosen: Text{text:"已选择";height:38px;color:Palette.blue;vertical-alignment:center;horizontal-alignment:center;font-size:13px;}
        if !root.chosen: ActionButton{text:root.dark-preview ? "切换为深色" : "切换为浅色";action-id:"appearance.toggle";horizontal-stretch:1;}
    }
}
component NavigationItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> action-id;
    in property <bool> chosen;
    in property <bool> compact;
    in property <bool> disabled;
    opacity:root.disabled ? 0.45 : 1;
    height:42px;border-radius:7px;
    forward-focus:nav-focus;
    border-color:Palette.blue;border-width:!root.disabled && nav-focus.has-focus ? 1px : 0px;
    background:root.chosen ? Palette.soft : touch.has-hover ? Palette.page : transparent;
    HorizontalLayout {
        padding-left:12px;padding-right:12px;spacing:12px;
        Rectangle {width:20px;
            Image {source:root.icon;width:20px;height:20px;y:(parent.height - self.height)/2;}
        }
        if !root.compact: Text {text:root.text;color:root.chosen ? Palette.blue : Palette.ink;font-weight:root.chosen ? 600 : 400;vertical-alignment:center;font-size:13px;}
        if !root.compact: Rectangle {horizontal-stretch:1;}
    }
    nav-focus:=FocusScope{focus-on-click:!root.disabled;focus-on-tab-navigation:!root.disabled;key-pressed(event)=>{if(!root.disabled && (event.text==Key.Return || event.text==" ")){Commands.trigger(root.action-id,"");return accept;}return reject;}}
    touch:=TouchArea {enabled:!root.disabled;mouse-cursor:pointer;clicked=>{nav-focus.focus();Commands.trigger(root.action-id,"");}}
    accessible-role:button;accessible-label:root.text;accessible-enabled:!root.disabled;
    accessible-id:"nav|"+root.action-id;
    accessible-action-default=>{if(!root.disabled){Commands.trigger(root.action-id,"");}}
    UiProbe{control-id:"nav|"+root.action-id;kind:"navigation";label:root.text;control-enabled:!root.disabled;focused:nav-focus.has-focus;remember-focus:false;control-width:root.width;control-height:root.height;focus-requested=>{nav-focus.focus();}}
}
component DeviceListPane inherits Rectangle {
    in property <bool> compact;
    in property <[DeviceRow]> devices;
    in property <string> selected-uuid;
    in property <string> device-query;
    in property <int> device-total;
    in property <int> device-online;
    in property <string> selection-action:"device.select";
width:root.compact ? 224px : 276px;background:Palette.surface;
                    Rectangle {x:parent.width - 1px;width:1px;background:Palette.line;}
                    VerticalLayout {padding:16px;spacing:16px;
                        HorizontalLayout {spacing:8px;height:36px;
                            Text {text:"远程设备";font-size:19px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                            Rectangle {horizontal-stretch:1;}
                            ActionButton {text:"刷新";action-id:"devices.refresh";height:32px;}
                        }
                        LineEdit {text:root.device-query;accessible-label:"搜索名称或地址";placeholder-text:"搜索名称或地址";height:36px;edited(value)=>{Commands.trigger("devices.filter",value);}}
                        ScrollView {test-id:"scroll|devices";horizontal-stretch:1;vertical-stretch:1;content-width:self.width;
                            VerticalLayout {spacing:6px;alignment:start;
                                for device in root.devices: Rectangle {
                                    height:86px;border-radius:8px;
                                    forward-focus:device-focus;
                                    border-width:device-focus.has-focus ? 1px : 0px;border-color:Palette.blue;
                                    background:device.uuid==root.selected-uuid ? Palette.soft : device-touch.has-hover ? Palette.page : transparent;
                                    if device.uuid==root.selected-uuid: Rectangle {x:0px;y:18px;width:3px;height:50px;border-radius:2px;background:Palette.blue;}
                                    HorizontalLayout {padding:12px;spacing:10px;
                                        Rectangle {width:34px;height:34px;border-radius:8px;background:Palette.page;vertical-stretch:0;
                                            Image {source:@image-url("icons/monitor.svg");width:21px;height:21px;x:6px;y:6px;}
                                        }
                                        VerticalLayout {spacing:5px;alignment:center;
                                            Text {text:device.name;color:Palette.ink;font-size:14px;font-weight:device.uuid==root.selected-uuid ? 600 : 400;overflow:elide;}
                                            Text {text:device.address;color:Palette.muted;font-size:11px;overflow:elide;}
                                            HorizontalLayout {spacing:5px;
                                                Rectangle {width:6px;height:6px;border-radius:3px;background:device.is-self ? Palette.blue : device.online ? #369c81 : #98a1b2;vertical-stretch:0;}
                                                Text {text:device.status;color:Palette.muted;font-size:10px;overflow:elide;}
                                            }
                                        }
                                    }
                                    device-focus:=FocusScope{key-pressed(event)=>{if(event.text==Key.Return || event.text==" "){Commands.trigger(root.selection-action,device.uuid);return accept;}return reject;}}
                                    UiProbe{control-id:"device|"+device.uuid;kind:"device";label:"选择设备 "+device.name;remember-focus:false;focused:device-focus.has-focus;control-width:parent.width;control-height:parent.height;focus-requested=>{device-focus.focus();}}
                                    device-touch:=TouchArea {mouse-cursor:pointer;clicked=>{device-focus.focus();Commands.trigger(root.selection-action,device.uuid);}}
                                    accessible-role:button;accessible-label:"选择设备 "+device.name;
                                    accessible-id:"device|"+device.uuid;
                                    accessible-action-default=>{Commands.trigger(root.selection-action,device.uuid);}
                                }
                                if root.devices.length==0: Text {text:root.device-query!="" ? "没有匹配的设备" : "尚未添加设备";color:Palette.muted;font-size:12px;height:80px;horizontal-alignment:center;vertical-alignment:center;}
                            }
                        }
                        Rectangle {height:1px;background:Palette.line;}
                        Text {text:root.device-total+" 台设备  ·  "+root.device-online+" 台在线";font-size:11px;color:Palette.muted;}
                    }

}
component DetailField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing:8px;
    Text {text:root.label;color:Palette.muted;font-size:12px;}
    Text {text:root.value;color:Palette.ink;font-size:14px;overflow:elide;}
}
component DeviceContextHeader inherits Rectangle {
    in property <DeviceRow> device;
    in property <string> name;
    in property <string> address;
    in property <string> uuid;
    in property <bool> compact;
    in property <bool> settings-open;
    height:136px;background:Palette.surface;
    VerticalLayout {spacing:0px;
        Rectangle {height:88px;background:Palette.page;
            VerticalLayout {padding:16px;padding-left:root.compact ? 20px : 24px;padding-right:20px;spacing:8px;
                HorizontalLayout {spacing:10px;
                    Text{text:root.name;font-size:24px;font-weight:600;color:Palette.ink;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;vertical-alignment:center;}
                    Rectangle {width:68px;height:26px;border-radius:13px;background:Palette.surface;
                        Text{text:root.device.is-self ? "本机" : root.device.online ? "在线" : "离线";color:root.device.is-self ? Palette.blue : root.device.online ? #369c81 : Palette.muted;font-size:11px;horizontal-alignment:center;vertical-alignment:center;}
                    }
                }
                Text{text:root.device.name==root.device.host-name ? root.address : root.device.host-name;color:Palette.muted;font-size:12px;overflow:elide;}
            }
        }
        Rectangle {height:48px;
            HorizontalLayout {padding-left:root.compact ? 20px : 24px;padding-right:20px;spacing:8px;
                TabButton{text:"概览";action-id:"device.select";argument:root.uuid;chosen:!root.settings-open;}
                TabButton{text:"连接设置";action-id:"device.settings.open";argument:root.uuid;chosen:root.settings-open;}
                Rectangle{horizontal-stretch:1;}
            }
            Rectangle{y:parent.height - 1px;height:1px;background:Palette.line;}
        }
    }
}
export component StreamToolbar inherits Window {
    private property <bool> themed-dark:Palette.dark;
    init=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    changed themed-dark=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    title:"RHRemote-Moonlight · 串流控制";no-frame:true;
    background:transparent;default-font-family:"Microsoft YaHei UI";default-font-size:12px;
    in property <bool> expanded:true;
    in property <bool> pending;
    in property <bool> canceling;
    in property <string> pending-cancel-label:"取消连接";
    in property <bool> audio-enabled;
    in property <int> audio-volume:100;
    in property <bool> stats-enabled;
    in property <bool> busy;
    in property <bool> failed;
    in property <string> controls-tab:"input";
    in property <string> device-name;
    in property <string> status;
    in property <[RemoteDisplay]> displays;
    in property <[string]> display-labels;
    in property <[string]> shortcut-labels;
    in property <[string]> shortcut-ids;
    in-out property <int> display-index:0;
    property <bool> narrow:self.width<400px;
    preferred-width:expanded || pending ? 560px : 72px;
    preferred-height:expanded ? 292px : pending ? (narrow ? 160px : 116px) : 28px;
    min-width:1px;min-height:1px;
    max-width:expanded || pending ? 560px : 72px;max-height:expanded ? 292px : pending ? (narrow ? 160px : 116px) : 28px;
    forward-focus:toolbar-focus;
    toolbar-focus:=FocusScope{
        focus-on-click:false;focus-on-tab-navigation:false;
        init=>{self.focus();}
        property <bool> body-visible:root.expanded || root.pending;
        changed body-visible=>{self.focus();}
        key-pressed(event)=>{
            if(event.text==Key.Escape){
                if(!event.repeat){
                    if(root.expanded){Commands.trigger("stream.controls.toggle","");}
                    else if(root.pending && !root.canceling){Commands.trigger("stream.disconnect","");}
                }
                return accept;
            }
            return reject;
        }
        UiProbe{control-id:"scope|toolbar";kind:"scope";focused:toolbar-focus.has-focus;remember-focus:false;focus-requested=>{toolbar-focus.focus();}}
    // The same handle remains at the center of the native stream's top edge.
    ActionButton {
        x:(parent.width - self.width)/2;y:0px;width:72px;height:28px;min-width:1px;border-radius:10px;
        primary:true;has-icon:true;icon:root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
        text:root.expanded ? "收起" : "控制";action-id:"stream.controls.toggle";
    }
    if root.pending && !root.expanded:Rectangle{
        y:28px;height:parent.height - 28px;
        background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;
        VerticalLayout{padding:12px;spacing:8px;
            Text{text:root.device-name;color:Palette.ink;font-size:13px;overflow:elide;}
            if !root.narrow:HorizontalLayout{spacing:12px;
                Text{text:root.status;color:Palette.muted;vertical-alignment:center;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;accessible-label:root.status;}
                ActionButton{text:root.pending-cancel-label;action-id:"stream.disconnect";disabled:root.canceling;}
            }
            if root.narrow:VerticalLayout{spacing:8px;
                Text{text:root.status;color:Palette.muted;wrap:word-wrap;vertical-stretch:1;accessible-label:root.status;}
                ActionButton{text:root.pending-cancel-label;action-id:"stream.disconnect";disabled:root.canceling;}
            }
        }
    }
    if root.expanded: Rectangle {
        y:28px;height:parent.height - 28px;
        background:Palette.surface;border-radius:12px;border-width:1px;border-color:Palette.line;
        VerticalLayout {
            padding:12px;spacing:8px;
            HorizontalLayout {spacing:8px;
                Text{text:root.device-name;color:Palette.ink;font-size:13px;vertical-alignment:center;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
                ActionButton{text:root.pending ? root.pending-cancel-label : "断开";action-id:"stream.disconnect";disabled:root.canceling;}
            }
            HorizontalLayout {spacing:6px;
                TabButton{text:"操作";action-id:"stream.controls.tab";argument:"input";chosen:root.controls-tab=="input";horizontal-stretch:1;}
                TabButton{text:"屏幕";action-id:"stream.controls.tab";argument:"displays";chosen:root.controls-tab=="displays";horizontal-stretch:1;}
                TabButton{text:"声音";action-id:"stream.controls.tab";argument:"audio";chosen:root.controls-tab=="audio";horizontal-stretch:1;}
            }
            ScrollView {test-id:"scroll|toolbar";vertical-stretch:1;
                VerticalLayout {spacing:8px;alignment:start;
                    if root.controls-tab=="input":VerticalLayout{spacing:8px;
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"Ctrl+Alt+Delete";subtle:true;has-icon:true;icon:@image-url("icons/lock.svg");action-id:"stream.shortcut";argument:"ctrl-alt-delete";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"shortcuts";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"Ctrl+Alt+Delete";subtle:true;has-icon:true;icon:@image-url("icons/lock.svg");action-id:"stream.shortcut";argument:"ctrl-alt-delete";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"快捷键 ▾";subtle:true;has-icon:true;icon:@image-url("icons/shortcuts.svg");action-id:"stream.menu.open";argument:"shortcuts";disabled:root.busy;horizontal-stretch:1;}
                        }
                        HorizontalLayout{Rectangle{horizontal-stretch:1;}ActionButton{text:root.stats-enabled ? "统计：开" : "统计：关";action-id:"stream.stats.toggle";chosen:root.stats-enabled;disabled:root.busy;has-icon:true;icon:@image-url("icons/chart.svg");}}
                    }
                    if root.controls-tab=="displays":VerticalLayout{spacing:8px;
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"自动选屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"auto";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"虚拟屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"virtual";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"自动选屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"auto";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"虚拟屏";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.display.select";argument:"virtual";disabled:root.busy;horizontal-stretch:1;}
                        }
                        HorizontalLayout{spacing:8px;
                            ActionButton{text:"显示器 ▾";subtle:true;has-icon:true;icon:@image-url("icons/monitor.svg");action-id:"stream.menu.open";argument:"displays";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"刷新";action-id:"stream.displays.refresh";disabled:root.busy;}
                        }
                        Text{text:root.display-labels.length>root.display-index && root.display-index>=0 ? root.display-labels[root.display-index] : "暂无屏幕信息";color:Palette.muted;font-size:12px;overflow:elide;}
                        if !root.narrow:HorizontalLayout{spacing:8px;
                            ActionButton{text:"窗口移到左屏";subtle:true;has-icon:true;icon:@image-url("icons/move-left.svg");action-id:"stream.window.move";argument:"left";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"窗口移到右屏";subtle:true;has-icon:true;icon:@image-url("icons/move-right.svg");action-id:"stream.window.move";argument:"right";disabled:root.busy;horizontal-stretch:1;}
                        }
                        if root.narrow:VerticalLayout{spacing:8px;
                            ActionButton{text:"窗口移到左屏";subtle:true;has-icon:true;icon:@image-url("icons/move-left.svg");action-id:"stream.window.move";argument:"left";disabled:root.busy;horizontal-stretch:1;}
                            ActionButton{text:"窗口移到右屏";subtle:true;has-icon:true;icon:@image-url("icons/move-right.svg");action-id:"stream.window.move";argument:"right";disabled:root.busy;horizontal-stretch:1;}
                        }
                    }
                    if root.controls-tab=="audio":VerticalLayout{spacing:8px;
                        ActionButton{text:root.audio-enabled ? "声音：开" : "声音：关";action-id:"stream.audio.toggle";chosen:root.audio-enabled;disabled:root.busy;}
                        HorizontalLayout{spacing:8px;
                            Text{text:"音量";color:Palette.ink;vertical-alignment:center;}
                            SpinBox{minimum:0;maximum:100;value:root.audio-volume;enabled:!root.busy;max-width:120px;accessible-label:"串流音量";edited(v)=>{Commands.trigger("stream.audio.volume",v);}}
                            Text{text:"%";color:Palette.muted;vertical-alignment:center;}
                        }
                    }
                }
            }
            HorizontalLayout{spacing:8px;
                Text{text:root.status;color:root.failed ? Palette.failure : Palette.muted;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;vertical-alignment:center;accessible-label:root.status;}
                if root.failed:ActionButton{text:"详情";action-id:"stream.menu.open";argument:"feedback";height:30px;}
            }
        }
    }
    }
}
export component StreamPicker inherits Window {
    private property <bool> themed-dark:Palette.dark;
    init=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    changed themed-dark=>{WidgetPalette.color-scheme=Palette.dark ? ColorScheme.dark : ColorScheme.light;}
    title:"RHRemote-Moonlight · 选择";no-frame:true;
    background:Palette.surface;default-font-family:"Microsoft YaHei UI";default-font-size:13px;
    in property <string> kind;
    in property <[string]> labels;
    in property <[string]> values;
    in property <[bool]> enabled-items;
    in property <[bool]> chosen-items;
    in property <bool> busy;
    in property <string> error;
    preferred-width:420px;preferred-height:400px;min-width:1px;min-height:1px;
    callback dismiss();
    forward-focus:focus;
    focus:=FocusScope{
        focus-on-click:false;focus-on-tab-navigation:false;
        init=>{self.focus();}
        property <string> active-kind:root.kind;
        changed active-kind=>{if(root.kind!=""){self.focus();}}
        key-pressed(event)=>{if(event.text==Key.Escape){root.dismiss();return accept;}return reject;}
        UiProbe{control-id:"scope|picker";kind:"scope";focused:focus.has-focus;remember-focus:false;focus-requested=>{focus.focus();}}
        VerticalLayout{padding:8px;spacing:6px;
            HorizontalLayout{
                Text{text:root.kind=="shortcuts" ? "快捷键" : root.kind=="feedback" ? "操作失败" : "屏幕";color:Palette.ink;vertical-alignment:center;}
                Rectangle{horizontal-stretch:1;}
                if root.kind!="feedback" && root.error!="":ActionButton{text:"详情";action-id:"stream.menu.open";argument:"feedback";}
                ActionButton{text:"关闭";action-id:"stream.menu.close";}
            }
            ScrollView{test-id:"scroll|picker";vertical-stretch:1;horizontal-stretch:1;
                VerticalLayout{spacing:4px;alignment:start;
                    if root.error!="":Text{text:root.error;color:Palette.failure;wrap:word-wrap;}
                    if root.kind!="feedback" && root.labels.length==0:Text{text:"暂无屏幕信息，请在屏幕分类刷新。";color:Palette.muted;wrap:word-wrap;}
                    if root.kind!="feedback":VerticalLayout{spacing:4px;
                        for item-label[index] in root.labels:Rectangle{
                            property <bool> available:!root.busy && (root.enabled-items.length<=index || root.enabled-items[index]);
                            property <bool> chosen:root.chosen-items.length>index && root.chosen-items[index];
                            height:40px;border-radius:8px;background:self.chosen || touch.has-hover ? Palette.soft : transparent;
                            forward-focus:row-focus;
                            border-width:row-focus.has-focus ? 1px : 0px;border-color:Palette.blue;
                            Text{x:10px;width:parent.width - 20px;text:item-label;color:parent.available ? Palette.ink : Palette.muted;vertical-alignment:center;overflow:elide;}
                            row-focus:=FocusScope{focus-on-click:parent.available;focus-on-tab-navigation:parent.available;key-pressed(event)=>{if(parent.available && (event.text==Key.Return || event.text==" ")){Commands.trigger(root.kind=="shortcuts" ? "stream.shortcut" : "stream.display.select",root.values[index]);return accept;}return reject;}}
                            touch:=TouchArea{enabled:parent.available;mouse-cursor:pointer;clicked=>{row-focus.focus();Commands.trigger(root.kind=="shortcuts" ? "stream.shortcut" : "stream.display.select",root.values[index]);}}
                            accessible-role:button;accessible-enabled:self.available;accessible-label:item-label;
                            accessible-id:"picker|"+root.kind+"|"+root.values[index];
                            accessible-action-default=>{if(self.available){Commands.trigger(root.kind=="shortcuts" ? "stream.shortcut" : "stream.display.select",root.values[index]);}}
                            UiProbe{control-id:"picker|"+root.kind+"|"+root.values[index];kind:"menu-item";label:item-label;control-enabled:parent.available;focused:row-focus.has-focus;control-width:parent.width;control-height:parent.height;focus-requested=>{row-focus.focus();}}
                        }
                    }
                }
            }
        }
    }
}
export component MainWindow inherits Window {
    init => { WidgetPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { WidgetPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    icon:@image-url("../../../shared/icons/rhremote.svg");
    title:root.isolated-preview ? "RHRemote-Moonlight · 测试预览" : "RHRemote-Moonlight";preferred-width:1180px;preferred-height:780px;min-width:720px;min-height:560px;
    private property <bool> device-context:!root.streaming && !root.connecting && (root.page=="devices" || root.page=="settings" || root.page=="profile-copy" || root.page=="device-info");
    private property <bool> narrow-profile:content-pane.width<560px;
    in property <bool> isolated-preview;
    background:Palette.page;default-font-family:"Microsoft YaHei UI";default-font-size:14px;
    in property <[DeviceRow]> devices;
    in property <DeviceRow> selected-device;
    in property <string> device-query;
    in property <string> add-address;
    in property <string> add-phase:"editing";
    in property <string> add-error;
    in property <string> info-name;
    in property <string> info-error;
    in property <bool> info-dirty;
    private property <bool> add-busy:root.add-phase=="probing";
    in property <int> device-total;
    in property <int> device-online;
    in property <int> selected-index;
    in property <string> page:"devices";
    in property <string> app-version;
    in property <string> selected-name;
    in property <string> client-name;
    in property <string> selected-uuid;
    in property <string> network-address;
    in property <string> network-addresses;
    in property <string> network-report;
    in property <[RouteRow]> network-routes;
    in property <string> relay-url;
    in property <string> draft-display-name;
    in property <[ProfileSource]> profile-sources;
    in property <string> profile-tab:"video";
    in property <[SettingRow]> profile-fields;
    in property <bool> profile-sources-expanded;
    in property <string> copy-source;
    in property <string> copy-target;
    in property <[CopyField]> copy-fields;
    in property <string> copy-notice;
    in property <string> copy-error;
    in property <bool> audio-enabled;
    in property <int> audio-volume:100;
    in property <string> status;
    in property <bool> dark;
    in property <int> profile-width:2520;
    in property <int> profile-height:1680;
    in property <int> fps:30;
    in property <int> bitrate:25;
    in property <string> codec:"HEVC";
    in property <bool> profile-audio-enabled;
    in property <string> profile-display;
    in property <bool> swapped;
    in property <bool> trackpad;
    in property <bool> statistics;
    in property <string> pair-pin;
    in property <bool> streaming;
    in property <bool> connecting;
    in property <string> connection-phase;
    in property <string> connection-operation;
    in property <string> connection-title;
    in property <string> connection-name;
    in property <string> connection-error;
    in property <bool> connection-busy;
    in property <bool> navigation-locked;
    in property <string> navigation-hint;
    in property <bool> control-requests-pending;
    in property <bool> controls;
    in property <string> stream-statistics;
    in property <[string]> shortcut-labels;
    in property <[string]> shortcut-ids;
    in property <[RemoteDisplay]> remote-displays;
    in property <string> display-error;
    in property <bool> compact:false;
    in property <string> settings-tab:"updates";
    in property <bool> test-mode:false;
    in property <string> trace-path:"";
    in property <string> sync-url;
    in property <string> sync-username;
    in property <bool> sync-automatic;
    in property <int> sync-interval-index;
    in property <bool> sync-has-password;
    in property <bool> sync-busy;
    in property <string> sync-progress-text:"同步中…";
    in property <bool> sync-dirty;
    in property <int> sync-generation;
    in property <string> sync-error;
    in property <string> navigation-message;
    in-out property <int> navigation-choice;
    in property <[SyncConflictRow]> sync-conflict-items;
    in property <string> sync-last;
    in property <bool> updates-managed;
    in property <bool> updates-busy;
    in property <bool> updates-available;
    in property <bool> updates-pending;
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-details;
    in property <string> update-primary-text:"检查更新";
    in property <bool> update-primary-installs;
    in property <string> update-phase;
    in property <int> update-progress;
    in property <string> network-summary;
    in property <string> network-current;
    in property <bool> settings-dirty;
    in property <string> settings-error;
    in property <length> form-inset:24px;
    in property <bool> navigation-prompt;
    in property <bool> sync-clear-prompt;
    in-out property <int> sync-clear-choice;

    main-keys:=FocusScope{
        // Handle rejected keys without becoming a pointer target or an extra Tab stop.
        focus-on-click:false;
        focus-on-tab-navigation:false;
        init=>{if(root.page!="add" && root.page!="device-info"){self.focus();}}
        in property <string> active-page:root.page;
        changed active-page=>{if(root.page!="add" && root.page!="device-info"){self.focus();}}
        property <string> dialog-page;
        property <bool> dialog-open:root.navigation-prompt || root.sync-clear-prompt;
        changed dialog-open=>{
            if(self.dialog-open){self.dialog-page=root.page;}
            else if(self.dialog-page==root.page){
                let target=KeyboardFocus.last-content-control;
                self.focus();KeyboardFocus.restore-target=target;KeyboardFocus.restore-generation+=1;
            }
        }
        key-pressed(event)=>{
            if(event.text==Key.Escape && root.page!="devices"){
                if(!event.repeat){Commands.trigger("navigation.back","");}return accept;
            }
            return reject;
        }
    UiProbe{control-id:"page";kind:"scope";focused:main-keys.has-focus;remember-focus:false;control-width:root.width;control-height:root.height;focus-requested=>{main-keys.focus();}}
    HorizontalLayout {
        spacing:0px;
        Rectangle {
            width:root.compact ? 64px : 184px;background:Palette.surface;
            Rectangle {x:parent.width - 1px;width:1px;background:Palette.line;}
            VerticalLayout {padding:root.compact ? 10px : 14px;spacing:8px;
                HorizontalLayout {height:76px;spacing:10px;
                    Image {height:32px;width:32px;source:@image-url("../../../shared/icons/rhremote.svg");}
                    if !root.compact: VerticalLayout {alignment:center;spacing:3px;
                        Text {text:"RHRemote";font-size:19px;font-weight:600;color:Palette.ink;}
                        Text {text:"Moonlight";font-size:11px;color:Palette.muted;}
                    }
                }
                NavigationItem{text:"远程设备";icon:@image-url("icons/monitor.svg");action-id:"devices.open";chosen:root.page=="devices" || root.page=="settings" || root.page=="profile-copy" || root.page=="device-info" || root.page=="pair" || root.page=="connection";compact:root.compact;disabled:root.navigation-locked;}
                NavigationItem{text:"添加电脑";icon:@image-url("icons/plus.svg");action-id:"device.add.open";chosen:root.page=="add";compact:root.compact;disabled:root.navigation-locked;}
                Rectangle {vertical-stretch:1;}
                NavigationItem{text:"设置";icon:@image-url("icons/settings.svg");action-id:"app.settings.open";chosen:root.page=="global-settings";compact:root.compact;disabled:root.navigation-locked;}
                NavigationItem{text:root.dark ? "浅色模式" : "深色模式";icon:@image-url("icons/moon.svg");action-id:"appearance.toggle";compact:root.compact;disabled:root.navigation-locked;}
                if root.isolated-preview:Text{text:root.compact ? "测试" : "测试预览 · 独立配置";color:Palette.blue;font-size:11px;horizontal-alignment:center;height:24px;}
                if !root.compact: Rectangle {height:52px;
                    VerticalLayout {padding-left:12px;alignment:center;spacing:5px;
                        Text {text:"v"+root.app-version;color:Palette.muted;font-size:11px;}
                        Text {text:"Moonlight · GPL v3";color:Palette.muted;font-size:10px;}
                    }
                }
            }
        }
        HorizontalLayout {spacing:0px;
            if root.device-context: DeviceListPane {
                compact:root.compact;devices:root.devices;selected-uuid:root.selected-uuid;
                device-query:root.device-query;device-total:root.device-total;device-online:root.device-online;
                selection-action:root.page=="settings" || root.page=="profile-copy" ? "device.settings.open" : root.page=="device-info" ? "device.info.open" : "device.select";
            }
        content-pane := VerticalLayout {
            spacing:0px;
            if root.page=="devices" && !root.streaming && !root.connecting: Rectangle {background:Palette.surface;
                    if root.selected-uuid!="": VerticalLayout {spacing:0px;
                        DeviceContextHeader{device:root.selected-device;name:root.selected-name;address:root.network-address;uuid:root.selected-uuid;compact:root.compact;}
                        ScrollView {test-id:"scroll|details";content-width:self.width;vertical-stretch:1;
                            VerticalLayout {padding:root.compact ? 20px : 28px;spacing:20px;alignment:start;
                                Rectangle {height:root.compact ? 132px : 148px;border-radius:10px;border-width:1px;border-color:Palette.line;
                                    HorizontalLayout {padding:20px;spacing:24px;
                                        if !root.compact: Rectangle {width:144px;border-radius:8px;background:Palette.page;
                                            Image {source:@image-url("icons/monitor.svg");width:54px;height:54px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2 - 6px;}
                                            Text {text:"远程桌面";color:Palette.muted;font-size:11px;height:20px;y:parent.height - 30px;horizontal-alignment:center;}
                                        }
                                        VerticalLayout {spacing:10px;alignment:center;
                                            Text {text:"桌面连接";font-size:16px;font-weight:600;color:Palette.ink;}
                                            Text {text:root.selected-device.is-self ? "本机不支持连接自身" : root.selected-device.paired ? "已配对" : "连接前需要配对";font-size:12px;color:Palette.muted;}
                                            HorizontalLayout {ActionButton {text:root.selected-device.is-self ? "本机" : root.selected-device.paired ? "连接" : "配对";action-id:root.selected-device.paired ? "device.connect" : "device.pair";argument:root.selected-uuid;primary:true;disabled:root.selected-device.is-self || root.control-requests-pending;min-width:112px;}Rectangle{horizontal-stretch:1;}}
                                        }
                                    }
                                }
                                HorizontalLayout {spacing:16px;
                                    DetailField {label:"分辨率";value:root.profile-width+" × "+root.profile-height;}
                                    Rectangle {width:1px;background:Palette.line;}
                                    DetailField {label:"帧率";value:root.fps+" FPS";}
                                    Rectangle {width:1px;background:Palette.line;}
                                    DetailField {label:"码率";value:root.bitrate+" Mbps";}
                                }
                                Rectangle {height:1px;background:Palette.line;}
                                HorizontalLayout {Text {text:"设备信息";font-size:14px;font-weight:600;color:Palette.ink;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}ActionButton{text:"编辑资料";action-id:"device.info.open";argument:root.selected-uuid;}}
                                HorizontalLayout {spacing:20px;
                                    DetailField {label:"首选地址";value:root.network-address;}
                                    DetailField {label:"配对状态";value:root.selected-device.paired ? "已配对" : "未配对";}
                                }
                                Text {text:root.network-summary;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                                Text {text:root.network-current;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                                Text {text:"当前客户端配置";font-size:14px;font-weight:600;color:Palette.ink;}
                                HorizontalLayout {spacing:20px;
                                    DetailField {label:"视频编码";value:root.codec;}
                                    DetailField {label:"声音";value:root.profile-audio-enabled ? "开启" : "关闭";}
                                    DetailField {label:"屏幕";value:root.profile-display=="virtual" ? "虚拟屏" : "自动";}
                                }
                                Rectangle {height:1px;background:Palette.line;}
                                HorizontalLayout {spacing:8px;
                                    Text {text:"设备顺序";color:Palette.muted;font-size:12px;vertical-alignment:center;}
                                    Rectangle {horizontal-stretch:1;}
                                    ActionButton {text:"上移";action-id:"device.move";argument:root.selected-uuid+"|up";disabled:root.selected-index<=0;}
                                    ActionButton {text:"下移";action-id:"device.move";argument:root.selected-uuid+"|down";disabled:root.selected-index>=root.device-total - 1;}
                                }
                                Text {text:root.status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            }
                        }
                    }
                    if root.selected-uuid=="": VerticalLayout {alignment:center;spacing:20px;padding:32px;
                        Text {text:"远程设备";font-size:22px;color:Palette.ink;horizontal-alignment:center;}
                        Text {text:"尚未添加设备";font-size:13px;color:Palette.muted;horizontal-alignment:center;}
                        HorizontalLayout {Rectangle {horizontal-stretch:1;}ActionButton {text:"添加电脑";action-id:"device.add.open";primary:true;}Rectangle {horizontal-stretch:1;}}
                    }
                }
            if root.page=="pair":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:pair-header.preferred-height;
                pair-header:=VerticalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:6px;
                    Text{text:"配对";font-size:23px;font-weight:600;color:Palette.ink;}
                    Text{text:root.connection-name;color:Palette.muted;font-size:13px;overflow:elide;}
                }
            }
            if root.page=="profile-copy":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:copy-header.preferred-height;
                copy-header:=VerticalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:6px;
                    Text{text:"复制配置";font-size:23px;font-weight:600;color:Palette.ink;}
                    Text{text:root.copy-target;color:Palette.muted;font-size:13px;overflow:elide;}
                }
            }
            if root.page=="settings": VerticalLayout {spacing:0px;vertical-stretch:0;
                DeviceContextHeader{device:root.selected-device;name:root.selected-name;address:root.network-address;uuid:root.selected-uuid;compact:root.compact;settings-open:true;}
                Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:profile-header.preferred-height;
                    profile-header:=VerticalLayout {padding:10px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                        HorizontalLayout {spacing:8px;
                        TabButton{text:"画面";action-id:"settings.tab";argument:"video";chosen:root.profile-tab=="video";}
                        TabButton{text:"音频";action-id:"settings.tab";argument:"audio";chosen:root.profile-tab=="audio";}
                        TabButton{text:"输入";action-id:"settings.tab";argument:"input";chosen:root.profile-tab=="input";}
                        TabButton{text:"网络";action-id:"settings.tab";argument:"network";chosen:root.profile-tab=="network";}
                        TabButton{text:"高级";action-id:"settings.tab";argument:"advanced";chosen:root.profile-tab=="advanced";}
                        Rectangle{horizontal-stretch:1;}
                    }
                    }
                }
            }
            if root.page=="global-settings": VerticalLayout {padding-left:root.form-inset;padding-right:root.form-inset;padding-top:16px;spacing:12px;vertical-stretch:0;
                        HorizontalLayout{Text{text:"设置";font-size:26px;font-weight:600;color:Palette.ink;}Rectangle{horizontal-stretch:1;}ActionButton{text:"返回";action-id:"devices.open";}}
                        HorizontalLayout{spacing:8px;
                            TabButton{text:"更新";action-id:"app.settings.tab";argument:"updates";chosen:root.settings-tab=="updates";}
                            TabButton{text:"配置同步";action-id:"app.settings.tab";argument:"sync";chosen:root.settings-tab=="sync";}
                            TabButton{text:"外观";action-id:"app.settings.tab";argument:"appearance";chosen:root.settings-tab=="appearance";}
                            TabButton{text:"关于";action-id:"app.settings.tab";argument:"about";chosen:root.settings-tab=="about";}
                            Rectangle{horizontal-stretch:1;}
                        }
            }
            if root.page=="device-info":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:info-header.preferred-height;
                info-header:=HorizontalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:12px;
                    Text{text:"设备资料";font-size:23px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}ActionButton{text:"返回设备";action-id:"navigation.back";}
                }
            }
            if root.page=="add":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:add-header.preferred-height;
                add-header:=HorizontalLayout{padding:20px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:12px;
                    Text{text:"添加电脑";font-size:23px;font-weight:600;color:Palette.ink;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}ActionButton{text:"返回设备";action-id:"device.add.cancel";}
                }
            }
            if root.page!="devices" || root.streaming || root.connecting: form-scroll:=ScrollView {test-id:"scroll|form";
                // A different page/category has different content. Ordinary draft and
                // background-state updates keep this key, so they retain the position.
                in property <string> content-context:root.page+"|"+(root.page=="settings" ? root.selected-uuid+"|"+root.profile-tab : root.page=="global-settings" ? root.settings-tab : "");
                changed content-context=>{self.content-y=0px;}
                in property <bool> syncing:root.sync-busy;
                changed syncing=>{if(!self.syncing && root.page=="global-settings" && root.settings-tab=="sync"){self.content-y=0px;}}
                content-width:self.width;
                VerticalLayout {
                    padding:root.compact ? 20px : 34px;padding-left:root.page=="settings" || root.page=="global-settings" || root.page=="add" || root.page=="device-info" || root.page=="profile-copy" ? root.form-inset : root.compact ? 20px : 34px;padding-right:root.page=="settings" || root.page=="global-settings" || root.page=="add" || root.page=="device-info" || root.page=="profile-copy" ? root.form-inset : root.compact ? 20px : 34px;spacing:18px;
                    if root.page=="profile-copy":VerticalLayout{spacing:18px;vertical-stretch:0;
                        DetailField{label:"来源客户端";value:root.copy-source;}
                        DetailField{label:"目标设备";value:root.copy-target;}
                        Text{text:"将替换当前草稿的连接参数。设备地址和主机鼠标设置沿用当前值。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        for field in root.copy-fields:DetailField{label:field.label;value:field.value;}
                    }
                    if root.page=="settings": SettingsCard {
                        if root.profile-tab=="advanced": VerticalLayout {spacing:12px;
                        HorizontalLayout{ActionButton{text:"从其他客户端复制配置";action-id:"settings.sources.toggle";chosen:root.profile-sources-expanded;disabled:root.profile-sources.length==0;}Rectangle{horizontal-stretch:1;}}
                        if root.profile-sources.length==0:Text{text:"同步其他客户端的连接设置后可复制。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.copy-error!="":Text{text:root.copy-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                        if root.profile-sources.length>0 && root.profile-sources-expanded: VerticalLayout{spacing:6px;
                            Text{text:"复制其他客户端的配置";color:Palette.muted;font-size:13px;}
                            for source in root.profile-sources: HorizontalLayout{spacing:8px;
                                Text{text:source.label;color:Palette.muted;vertical-alignment:center;font-size:12px;min-width:0px;preferred-width:0px;horizontal-stretch:1;overflow:elide;}
                                ActionButton{text:"查看配置";action-id:"settings.copy.preview";argument:source.client-id;}
                            }
                        }
                        }
                        if root.profile-tab=="network": VerticalLayout{spacing:10px;
                            Text{text:"设备地址";color:Palette.ink;}
                            Text{text:root.network-summary;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            Text{text:"连接会按路径顺序尝试所有已保存地址，内网地址不会限制外网连接。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            network-primary:=LineEdit{text:root.network-address;accessible-label:"首选 IP 或主机名";placeholder-text:"首选 IP 或主机名";edited(value)=>{Commands.trigger("settings.network.edit","address="+value);}}
                            network-extra:=LineEdit{text:root.network-addresses;accessible-label:"备用地址";placeholder-text:"备用地址，以逗号分隔，例如 100.x.x.x";edited(value)=>{Commands.trigger("settings.network.edit","addresses="+value);}}
                            HorizontalLayout{
                                ActionButton{text:"诊断连接";action-id:"device.network.diagnose";argument:root.selected-uuid;}
                                Rectangle{horizontal-stretch:1;}
                            }
                            Text{text:"连接顺序";color:Palette.ink;}
                            for route in root.network-routes: HorizontalLayout{spacing:6px;
                                CheckBox{text:route.label;checked:route.enabled;enabled:!route.enabled || route.can-disable;accessible-label:"连接路径："+route.label;toggled=>{Commands.trigger("settings.route.toggle",route.key);}}
                                Rectangle{horizontal-stretch:1;}
                                if route.enabled: ActionButton{text:"↑";action-id:"settings.route.move";argument:route.key+"|up";disabled:!route.can-move-up;accessible-label:"上移"+route.label;}
                                if route.enabled: ActionButton{text:"↓";action-id:"settings.route.move";argument:route.key+"|down";disabled:!route.can-move-down;accessible-label:"下移"+route.label;}
                            }
                            Text{text:"至少启用一条连接路径。";color:Palette.muted;font-size:12px;}
                            ActionButton{text:"恢复默认顺序";action-id:"settings.set";argument:"routeOrder=default";}
                            Text{text:"中继服务器";color:Palette.ink;}
                            relay-edit:=LineEdit{text:root.relay-url;accessible-label:"中继服务器";placeholder-text:"https://relay.example.com";edited(value)=>{Commands.trigger("settings.network.edit","relayUrl="+value);}}
                            Text{text:"按顺序尝试已启用的路径；同类路径按实测质量选择。更改随本设备连接配置同步。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                            Text{text:root.network-report;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                        }
                        if root.profile-tab=="video":VerticalLayout {spacing:6px;
                            if !root.narrow-profile:HorizontalLayout{spacing:6px;
                                ActionButton{text:"720P";chosen:root.profile-width==1280 && root.profile-height==720;action-id:"settings.set";argument:"resolution=1280x720";}
                                ActionButton{text:"1080P";chosen:root.profile-width==1920 && root.profile-height==1080;action-id:"settings.set";argument:"resolution=1920x1080";}
                                ActionButton{text:"1440P";chosen:root.profile-width==2560 && root.profile-height==1440;action-id:"settings.set";argument:"resolution=2560x1440";}
                                ActionButton{text:"平板";chosen:root.profile-width==2520 && root.profile-height==1680;action-id:"settings.set";argument:"resolution=2520x1680";}
                                ActionButton{text:"4K";chosen:root.profile-width==3840 && root.profile-height==2160;action-id:"settings.set";argument:"resolution=3840x2160";}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if root.narrow-profile:VerticalLayout{spacing:6px;
                                HorizontalLayout{spacing:6px;ActionButton{text:"720P";chosen:root.profile-width==1280 && root.profile-height==720;action-id:"settings.set";argument:"resolution=1280x720";}ActionButton{text:"1080P";chosen:root.profile-width==1920 && root.profile-height==1080;action-id:"settings.set";argument:"resolution=1920x1080";}ActionButton{text:"1440P";chosen:root.profile-width==2560 && root.profile-height==1440;action-id:"settings.set";argument:"resolution=2560x1440";}Rectangle{horizontal-stretch:1;}}
                                HorizontalLayout{spacing:6px;ActionButton{text:"平板";chosen:root.profile-width==2520 && root.profile-height==1680;action-id:"settings.set";argument:"resolution=2520x1680";}ActionButton{text:"4K";chosen:root.profile-width==3840 && root.profile-height==2160;action-id:"settings.set";argument:"resolution=3840x2160";}Rectangle{horizontal-stretch:1;}}
                            }
                        }
                        for field in root.profile-fields: VerticalLayout{spacing:6px;
                            if root.narrow-profile:Text{text:field.label;color:Palette.ink;wrap:word-wrap;}
                            HorizontalLayout{spacing:16px;
                                if !root.narrow-profile:Text{text:field.label;color:Palette.ink;vertical-alignment:center;}
                                if !root.narrow-profile:Rectangle{horizontal-stretch:1;}
                                if field.kind=="bool": ActionButton{text:field.flag ? "开启" : "关闭";chosen:field.flag;action-id:"settings.set";argument:field.key+"=toggle";accessible-label:field.label+"："+self.text;}
                                if field.kind=="number": HorizontalLayout {spacing:6px;horizontal-stretch:0;
                                    ActionButton{text:"−";action-id:"settings.step";argument:field.key+"|down";accessible-label:"减少"+field.label;}
                                    Rectangle {width:92px;height:38px;border-width:field.invalid ? 2px : 0px;border-radius:6px;border-color:Palette.failure;
                                        LineEdit{width:parent.width;height:parent.height;text:field.input-text;accessible-label:field.label;edited(value)=>{Commands.trigger("settings.input",field.key+"="+value);}}
                                    }
                                    ActionButton{text:"＋";action-id:"settings.step";argument:field.key+"|up";accessible-label:"增加"+field.label;}
                                }
                                if field.kind=="select": field-choice:=ComboBox{model:field.option-labels;current-index:field.selected-index;width:200px;horizontal-stretch:0;accessible-label:field.label;selected(value)=>{Commands.trigger("settings.set",field.key+"="+field.option-values[self.current-index]);}}
                                if root.narrow-profile:Rectangle{horizontal-stretch:1;}
                            }
                            if field.help!="": Text{text:field.help;color:Palette.muted;font-size:12px;wrap:word-wrap;}
                        }
                        if root.profile-tab=="audio": Text{text:"主机 Sunshine 需启用音频捕获。串流中可随时切换声音和音量。";color:Palette.muted;font-size:12px;wrap:word-wrap;}
                    }
                    if root.page=="global-settings": VerticalLayout {spacing:20px;vertical-stretch:0;
                        if root.settings-tab=="appearance": VerticalLayout{spacing:16px;
                            Text{text:"主题";color:Palette.ink;font-size:18px;font-weight:600;}
                            HorizontalLayout{spacing:16px;ThemePreview{dark-preview:false;chosen:!root.dark;}ThemePreview{dark-preview:true;chosen:root.dark;}}
                        }
                        if root.settings-tab=="sync": SettingsCard {
                            Text{text:"WebDAV";color:Palette.ink;font-size:18px;font-weight:600;}
                            Text{text:root.sync-last;color:Palette.muted;font-size:12px;}
                            HorizontalLayout{spacing:10px;
                                ActionButton{text:root.sync-busy ? root.sync-progress-text : "立即同步";primary:true;action-id:"sync.run";disabled:root.sync-busy || !root.sync-has-password;}
                                ActionButton{text:"移除同步设置";action-id:"sync.clear";disabled:root.sync-busy || !root.sync-has-password;}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if root.sync-conflict-items.length>0: VerticalLayout{spacing:12px;
                                Text{text:root.sync-conflict-items.length+" 项配置存在冲突。选择保留哪一端的冲突项，其余改动会合并。";color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                HorizontalLayout{spacing:10px;ActionButton{text:"冲突项保留本机";action-id:"sync.resolve";argument:"local";disabled:root.sync-busy;}ActionButton{text:"冲突项保留远端";action-id:"sync.resolve";argument:"remote";disabled:root.sync-busy;}Rectangle{horizontal-stretch:1;}}
                                for item in root.sync-conflict-items: Rectangle{border-radius:12px;border-width:1px;border-color:Palette.line;background:Palette.soft;vertical-stretch:0;
                                    VerticalLayout{padding:14px;spacing:6px;
                                        Text{text:item.label;color:Palette.ink;wrap:word-wrap;font-size:14px;font-weight:600;}
                                        Text{text:"本机："+item.local;color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                        Text{text:"远端："+item.remote;color:Palette.muted;wrap:word-wrap;font-size:13px;}
                                    }
                                }
                            }
                            Text{text:"目录地址（HTTP / HTTPS）";color:Palette.muted;}
                            dav-url:=LineEdit{enabled:!root.sync-busy;text:root.sync-url;accessible-label:"WebDAV 目录地址（HTTP / HTTPS）";placeholder-text:"https://example.com/dav/RHRemote/";edited(value)=>{Commands.trigger("sync.edit","url="+value);}}
                            Text{text:"用户名";color:Palette.muted;}
                            dav-user:=LineEdit{enabled:!root.sync-busy;text:root.sync-username;accessible-label:"WebDAV 用户名";edited(value)=>{Commands.trigger("sync.edit","username="+value);}}
                            Text{text:"密码";color:Palette.muted;}
                            dav-password:=LineEdit{enabled:!root.sync-busy;in property <int> generation:root.sync-generation;changed generation=>{self.text="";}input-type:password;accessible-label:"WebDAV 密码";placeholder-text:root.sync-has-password ? "已保存，留空保留" : "WebDAV 密码";edited(value)=>{Commands.trigger("sync.edit","password="+value);}}
                            HorizontalLayout{
                                dav-auto:=CheckBox{enabled:!root.sync-busy;text:"自动同步";checked:root.sync-automatic;toggled=>{Commands.trigger("sync.edit","automatic="+(self.checked ? "true" : "false"));}}
                                dav-interval:=ComboBox{enabled:!root.sync-busy;model:["5 分钟","15 分钟","30 分钟","60 分钟"];current-index:root.sync-interval-index;preferred-width:150px;horizontal-stretch:0;accessible-label:"自动同步间隔";selected(value)=>{Commands.trigger("sync.edit","intervalMinutes="+(self.current-index==0?"5":self.current-index==1?"15":self.current-index==2?"30":"60"));}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            Text{text:"同步设备列表、各客户端的连接配置和主题。各端只使用自己的配置；其他端的配置可手动复制。配对密钥及本机凭据不参与同步。";color:Palette.muted;wrap:word-wrap;font-size:12px;}
                        }
                        if root.settings-tab=="updates": SettingsCard {
                            HorizontalLayout {spacing:16px;
                                Image {source:@image-url("../../../shared/icons/rhremote.svg");width:48px;height:48px;}
                                VerticalLayout {spacing:5px;Text{text:"RHRemote";color:Palette.ink;font-size:22px;font-weight:600;}Text{text:"Moonlight · "+root.app-version;color:Palette.muted;font-size:13px;}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            Text{text:root.updates-managed ? "自动检查更新 · GitHub / Gitee" : "当前为开发预览版，应用内更新仅在正式安装版中可用。";color:Palette.muted;wrap:word-wrap;}
                            if root.updates-available: Text{text:"可用版本："+root.update-version;color:Palette.ink;}
                            if root.updates-busy: Rectangle {height:4px;background:Palette.line;border-radius:2px;
                                Rectangle {height:parent.height;width:parent.width * (root.update-phase=="downloading" ? root.update-progress / 100 : 0.12);background:Palette.blue;border-radius:2px;}
                            }
                            Text{text:root.update-phase=="error" ? "更新失败，请重试。" : root.update-status;color:root.update-phase=="error" ? Palette.failure : Palette.muted;wrap:word-wrap;font-size:14px;}
                            if root.update-phase=="error":HorizontalLayout{ActionButton{text:root.update-details ? "收起详情" : "查看详情";action-id:"updates.details.toggle";chosen:root.update-details;}Rectangle{horizontal-stretch:1;}}
                            if root.update-phase=="error" && root.update-details:Text{text:root.update-status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            Text{text:root.streaming || root.connecting ? "请先断开远程连接再安装更新。" : "安装时会重启 RHRemote。";color:Palette.muted;wrap:word-wrap;font-size:12px;}
                        }
                        if root.settings-tab=="about": VerticalLayout{spacing:16px;
                            SettingsCard {HorizontalLayout{spacing:16px;Image{source:@image-url("../../../shared/icons/rhremote.svg");width:48px;height:48px;}VerticalLayout{spacing:5px;Text{text:"RHRemote";font-size:22px;font-weight:600;color:Palette.ink;}Text{text:"Moonlight · "+root.app-version;color:Palette.muted;font-size:13px;}}Rectangle{horizontal-stretch:1;}}}
                            SettingsCard {Text{text:"开源组件";font-size:16px;font-weight:600;color:Palette.ink;}HorizontalLayout{Text{text:"客户端核心";width:100px;color:Palette.muted;font-size:13px;}Text{text:"Moonlight";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}HorizontalLayout{Text{text:"服务端";width:100px;color:Palette.muted;font-size:13px;}Text{text:"Sunshine";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}HorizontalLayout{Text{text:"许可证";width:100px;color:Palette.muted;font-size:13px;}Text{text:"GPL v3";color:Palette.ink;font-size:13px;}Rectangle{horizontal-stretch:1;}}}
                            SettingsCard {
                            Text{text:"诊断";font-size:16px;font-weight:600;color:Palette.ink;}
                            HorizontalLayout{Text{text:"连接统计";color:Palette.ink;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}ActionButton{text:root.test-mode?"测试统计：开启":"测试统计：关闭";action-id:"statistics.configure";argument:root.test-mode?"false":"true";chosen:root.test-mode;disabled:root.streaming||root.connecting;}}
                            Text{text:"测试模式每次连接记录阶段和逐帧时间。分析后自动清理原始记录。";color:Palette.muted;wrap:word-wrap;}
                            if root.trace-path!="": Text{text:root.trace-path;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                            }
                        }
                    }
                    if root.page=="device-info":SettingsCard {
                        Text{text:"设备名称";color:Palette.ink;font-size:14px;}
                        info-editor:=LineEdit{init=>{self.focus();}text:root.info-name;placeholder-text:root.selected-device.host-name;accessible-label:"设备名称";enabled:!root.sync-busy;edited(value)=>{Commands.trigger("device.info.input",value);}accepted=>{Commands.trigger("device.info.save","");}}
                        if root.info-error!="":Text{text:root.info-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                        Text{text:"留空使用主机名。显示名称随设备配置同步。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        HorizontalLayout{ActionButton{text:"恢复原名";action-id:"device.info.reset";disabled:root.info-name=="";}Rectangle{horizontal-stretch:1;}}
                        Rectangle{height:1px;background:Palette.line;}
                        DetailField{label:"主机名";value:root.selected-device.host-name;}
                        Text{text:"设备标识";color:Palette.muted;font-size:12px;}
                        Text{text:root.selected-uuid;color:Palette.ink;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="add": SettingsCard {
                        Text{text:"IP 或主机名，支持局域网、Tailscale 和公网地址";color:Palette.muted;wrap:word-wrap;}
                        Text{text:"设备地址";color:Palette.ink;font-size:14px;}
                        address:=LineEdit {init=>{self.focus();}text:root.add-address;enabled:!root.add-busy;accessible-label:"设备地址";placeholder-text:"例如 192.168.0.104 或 100.x.x.x";edited(value)=>{Commands.trigger("device.add.input",value);}accepted=>{Commands.trigger("device.add.submit",self.text);}}
                        if root.sync-busy:Text{text:"配置正在同步，完成后可添加设备。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.add-error!="":Text{text:root.add-error;color:Palette.failure;wrap:word-wrap;font-size:13px;}
                        if root.add-busy:VerticalLayout{spacing:12px;
                            ProgressIndicator{indeterminate:true;}
                            Text{text:"正在查找设备…";color:Palette.muted;font-size:13px;}
                        }
                        Text{text:"找到设备后会保存到远程设备列表，配对在设备详情中完成。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="connection": VerticalLayout{spacing:22px;vertical-stretch:0;
                        HorizontalLayout{spacing:14px;
                            Rectangle{width:48px;height:48px;background:Palette.soft;border-radius:12px;
                                Image{source:@image-url("icons/monitor.svg");width:26px;height:26px;x:11px;y:11px;}
                            }
                            VerticalLayout{spacing:6px;alignment:center;
                                Text{text:root.connection-name;color:Palette.ink;font-size:24px;font-weight:600;overflow:elide;}
                                Text{text:root.connection-title;color:root.connection-phase=="failed" ? Palette.failure : Palette.muted;font-size:14px;wrap:word-wrap;}
                            }
                        }
                        if root.connection-busy && root.connection-phase!="connected":ProgressIndicator{indeterminate:true;}
                        if root.connection-operation!="pair":VerticalLayout{spacing:22px;
                            Text{text:"1  检查地址与配对";color:root.connection-phase=="resolving" ? Palette.blue : Palette.muted;font-size:14px;}
                            Text{text:"2  建立串流";color:root.connection-phase=="starting" ? Palette.blue : Palette.muted;font-size:14px;}
                            Text{text:"3  显示远程画面";color:root.connection-phase=="first-frame" || root.connection-phase=="connected" ? Palette.blue : Palette.muted;font-size:14px;}
                        }
                        if root.connection-error!="":Text{text:root.connection-error;color:Palette.failure;font-size:14px;wrap:word-wrap;}
                        if root.control-requests-pending:Text{text:"正在结束上一项会话操作…";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                        if root.connection-phase=="connected":Text{text:"会话控制位于远程画面上方。";color:Palette.muted;font-size:13px;wrap:word-wrap;}
                    }
                    if root.page=="pair": VerticalLayout {spacing:22px;
                        Text{text:"请在这台电脑的 RHRemote-Sunshine 管理界面输入配对码：";color:Palette.muted;wrap:word-wrap;}
                        Text{text:root.pair-pin;color:Palette.blue;font-size:44px;}
                        Text{text:"等待主机确认配对";color:Palette.muted;wrap:word-wrap;}
                    }
                    if root.page!="settings" && root.page!="global-settings" && root.page!="add" && root.page!="device-info" && root.page!="connection" && root.page!="pair" && root.page!="profile-copy" && root.status!="": Text{text:root.status;color:Palette.muted;wrap:word-wrap;font-size:12px;}
                    Rectangle {min-height:12px;vertical-stretch:1;}

            Text{text:"基于 Moonlight 开源核心 · GPL v3";color:Palette.muted;font-size:11px;}
                }
            }
            if root.page=="global-settings" && root.settings-tab=="updates":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:update-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                update-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:root.update-primary-text;action-id:"updates.primary";primary:true;disabled:root.updates-busy || !root.updates-managed || (root.update-primary-installs && (root.streaming || root.connecting));}
                }
            }
            if root.page=="connection" || root.page=="pair":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:connection-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                connection-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Text{text:root.navigation-hint;color:Palette.muted;font-size:12px;wrap:word-wrap;vertical-alignment:center;horizontal-stretch:1;}
                    if root.connection-busy:ActionButton{text:root.connection-phase=="cancelling" || root.connection-phase=="cleaning" ? "正在清理…" : root.connection-operation=="pair" ? "取消配对" : root.connection-phase=="connected" ? "断开连接" : "取消连接";action-id:root.connection-operation=="pair" ? "pair.cancel" : "stream.disconnect";disabled:root.connection-phase=="cancelling" || root.connection-phase=="cleaning";}
                    if !root.connection-busy:ActionButton{text:"返回设备";action-id:"connection.dismiss";}
                    if !root.connection-busy && root.connection-phase=="failed":ActionButton{text:root.connection-operation=="pair" ? "重试配对" : "重试连接";action-id:"connection.retry";primary:true;disabled:root.control-requests-pending;}
                }
            }
            if root.page=="profile-copy":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:copy-footer.preferred-height;
                Rectangle{x:0px;y:0px;width:parent.width;height:1px;background:Palette.line;}
                copy-footer:=VerticalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.copy-error!="":Text{text:root.copy-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                    HorizontalLayout{spacing:10px;Rectangle{horizontal-stretch:1;}ActionButton{text:"取消";action-id:"settings.copy.cancel";}ActionButton{text:"复制到草稿";action-id:"settings.copy.apply";primary:true;disabled:root.copy-source=="";}}
                }
            }
            if root.page=="settings": Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:profile-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                profile-footer:=VerticalLayout {padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.settings-error!="": Text{text:root.settings-error;color:Palette.failure;font-size:13px;wrap:word-wrap;}
                    HorizontalLayout {spacing:10px;
                        Text{text:root.copy-notice!="" ? root.copy-notice : root.settings-dirty ? "有未保存的更改" : "设置已保存";color:Palette.muted;font-size:12px;vertical-alignment:center;overflow:elide;}
                        Rectangle{horizontal-stretch:1;}
                        ActionButton{text:"取消";action-id:"settings.cancel";}
                        ActionButton{text:"保存";action-id:"settings.save";primary:true;disabled:!root.settings-dirty;}
                    }
                }
            }
            if root.page=="device-info":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:info-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                info-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Text{text:root.info-dirty ? "有未保存的更改" : "";color:Palette.muted;font-size:12px;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}ActionButton{text:"取消";action-id:"device.info.cancel";}
                    ActionButton{text:"完成";action-id:"device.info.save";primary:true;disabled:root.sync-busy;}
                }
            }
            if root.page=="add":Rectangle{background:Palette.surface;vertical-stretch:0;preferred-height:add-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                add-footer:=HorizontalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:10px;
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:"取消";action-id:"device.add.cancel";}
                    ActionButton{text:root.add-busy ? "正在查找…" : "添加";action-id:"device.add.submit";argument:root.add-address;primary:true;disabled:root.add-busy || root.sync-busy || root.add-address=="";}
                }
            }
            if root.page=="global-settings" && root.settings-tab=="sync": Rectangle {background:Palette.surface;vertical-stretch:0;preferred-height:sync-footer.preferred-height;
                Rectangle{y:0px;x:0px;width:parent.width;height:1px;background:Palette.line;}
                sync-footer:=VerticalLayout{padding:16px;padding-left:root.form-inset;padding-right:root.form-inset;spacing:8px;
                    if root.sync-error!="":Text{text:root.sync-error;color:Palette.failure;wrap:word-wrap;font-size:13px;}
                    HorizontalLayout{spacing:10px;
                        Text{text:root.sync-dirty ? "有未保存的更改" : root.sync-has-password ? "设置已保存" : "未配置";color:Palette.muted;vertical-alignment:center;font-size:12px;}
                        Rectangle{horizontal-stretch:1;}
                        ActionButton{text:"取消";action-id:"sync.cancel";disabled:root.sync-busy || !root.sync-dirty;}
                        ActionButton{text:"保存";primary:true;action-id:"sync.save";disabled:root.sync-busy || !root.sync-dirty;}
                    }
                }
            }

        }
        }
    }
    if root.sync-clear-prompt: Rectangle {background:#0006;
        TouchArea{}
        Rectangle {width:min(parent.width - 32px,480px);height:clear-decision.preferred-height;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Palette.surface;border-radius:12px;
            in property <int> selected-choice:root.sync-clear-choice;
            init=>{clear-cancel.focus();}
            changed selected-choice=>{if(self.selected-choice==0){clear-cancel.focus();}else{clear-confirm.focus();}}
            clear-decision:=VerticalLayout {padding:24px;spacing:18px;
                Text{text:"移除同步设置？";color:Palette.ink;font-size:22px;font-weight:600;}
                Text{text:"仅移除此设备保存的 WebDAV 地址和登录信息，并关闭自动同步。本机远程设备和服务器上的配置文件保留。";color:Palette.muted;wrap:word-wrap;font-size:14px;}
                if root.sync-error!="":Text{text:root.sync-error;color:Palette.failure;wrap:word-wrap;font-size:13px;}
                HorizontalLayout {spacing:8px;Rectangle{horizontal-stretch:1;}clear-cancel:=ActionButton{focused-in=>{root.sync-clear-choice=0;}text:"取消";action-id:"sync.clear.resolve";argument:"cancel";chosen:root.sync-clear-choice==0;disabled:root.sync-busy;}clear-confirm:=ActionButton{focused-in=>{root.sync-clear-choice=1;}text:"移除";action-id:"sync.clear.resolve";argument:"remove";chosen:root.sync-clear-choice==1;disabled:root.sync-busy;}}
            }
        }
    }
    if root.navigation-prompt: Rectangle {background:#0006;
        TouchArea{}
        Rectangle {width:min(parent.width - 32px,480px);height:decision.preferred-height + 48px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Palette.surface;border-radius:12px;
            in property <int> selected-choice:root.navigation-choice;
            init=>{continue-choice.focus();}
            changed selected-choice=>{if(self.selected-choice==0){continue-choice.focus();}else if(self.selected-choice==1){discard-choice.focus();}else{save-choice.focus();}}
            decision:=VerticalLayout {padding:24px;spacing:18px;
                Text{text:"保存更改？";color:Palette.ink;font-size:22px;font-weight:600;}
                Text{text:root.navigation-message;color:Palette.muted;wrap:word-wrap;font-size:14px;}
                HorizontalLayout {spacing:8px;continue-choice:=ActionButton{focused-in=>{root.navigation-choice=0;}text:"继续编辑";action-id:"navigation.resolve";argument:"stay";chosen:root.navigation-choice==0;}Rectangle{horizontal-stretch:1;}discard-choice:=ActionButton{focused-in=>{root.navigation-choice=1;}text:"放弃更改";action-id:"navigation.resolve";argument:"discard";chosen:root.navigation-choice==1;}save-choice:=ActionButton{focused-in=>{root.navigation-choice=2;}text:"保存并继续";action-id:"navigation.resolve";argument:"save";chosen:root.navigation-choice==2;primary:true;}}
            }
        }
    }

    }
}
