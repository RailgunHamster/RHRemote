    in property <string> navigation-request-id;
    in property <string> profile-draft-id;
    in property <string> sync-clear-request-id;
    in-out property <int> navigation-choice;
    in property <[SyncConflictRow]> sync-conflict-items;
    in property <string> sync-review-id;
    in property <string> sync-last;
    in property <bool> updates-managed;
