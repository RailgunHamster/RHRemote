+void FFmpegVideoDecoder::saveDiagnosticSnapshot(AVFrame* frame)
+{
+    // One opt-in decoded-image check during warmup, independent of desktop
+    // occlusion and Windows window-capture behavior. Never overwrite a file.
+    const QString path = qEnvironmentVariable("RHREMOTE_DECODED_SNAPSHOT");
+    AVFrame* software = av_frame_alloc();
+    if (!software) return;
+    AVFrame* pixels = frame;
+    if (frame->hw_frames_ctx) {
+        if (av_hwframe_transfer_data(software, frame, 0) < 0) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "RHRemote decoded snapshot transfer failed");
+            av_frame_free(&software);
+            return;
+        }
+        pixels = software;
+    }
+    if (pixels->width <= 0 || pixels->height <= 0 || pixels->width > 8192 || pixels->height > 8192) {
+        av_frame_free(&software);
+        return;
+    }
+    SwsContext* conversion = sws_getContext(pixels->width, pixels->height, static_cast<AVPixelFormat>(pixels->format),
+                                            pixels->width, pixels->height, AV_PIX_FMT_BGRA, SWS_POINT, nullptr, nullptr, nullptr);
+    if (conversion) {
+        QImage image(pixels->width, pixels->height, QImage::Format_ARGB32);
+        if (!image.isNull()) {
+            uint8_t* destination[4] = {image.bits(), nullptr, nullptr, nullptr};
+            int stride[4] = {static_cast<int>(image.bytesPerLine()), 0, 0, 0};
+            int rows = sws_scale(conversion, pixels->data, pixels->linesize, 0, pixels->height, destination, stride);
+            QFile output(path);
+            if (rows == pixels->height && output.open(QIODevice::WriteOnly | QIODevice::NewOnly) && image.save(&output, "PNG")) {
+                SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "RHRemote decoded snapshot saved: %dx%d pts=%lld path=%s",
+                            pixels->width, pixels->height, static_cast<long long>(frame->pts), qPrintable(path));
+            } else {
+                SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "RHRemote decoded snapshot save failed");
+            }
+        }
+        sws_freeContext(conversion);
+    }
+    av_frame_free(&software);
+}
