[Unit]
Description=RHRemote-Sunshine
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/rhremote-server run
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed
UMask=0077

[Install]
WantedBy=graphical-session.target
